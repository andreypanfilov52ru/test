Процедура НесоответсвиеНоменклатурыАкцизныхМарокИсправитьНоменклатуруВМарке()
	
	УстановитьПривилегированныйРежим(Истина);
		
	ПараметрыТаблицаТоваров = Новый Структура("Справка2");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТТНМарка.ТТН КАК ТТН,
	                      |	ТТНМарка.АкцизнаяМарка КАК АкцизнаяМарка,
	                      |	ПоступлениеТоваровТовары.Номенклатура КАК НоменклатураПриход,
	                      |	ТТНМарка.АкцизнаяМаркаНоменклатура КАК АкцизнаяМаркаНоменклатура,
	                      |	ТТНМарка.Справка2 КАК Справка2,
	                      |	ПоступлениеТоваровТовары.Ссылка КАК ПоступлениеТоваров
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ТТНВходящаяЕГАИСТовары.Ссылка КАК ТТН,
	                      |		ТТНВходящаяЕГАИСТовары.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
	                      |		ТТНВходящаяЕГАИСАкцизныеМарки.АкцизнаяМарка КАК АкцизнаяМарка,
	                      |		ТТНВходящаяЕГАИСАкцизныеМарки.АкцизнаяМарка.Номенклатура КАК АкцизнаяМаркаНоменклатура,
	                      |		ТТНВходящаяЕГАИСАкцизныеМарки.Справка2 КАК Справка2
	                      |	ИЗ
	                      |		Документ.ТТНВходящаяЕГАИС.Товары КАК ТТНВходящаяЕГАИСТовары
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТТНВходящаяЕГАИС.АкцизныеМарки КАК ТТНВходящаяЕГАИСАкцизныеМарки
	                      |			ПО ТТНВходящаяЕГАИСТовары.Ссылка = ТТНВходящаяЕГАИСАкцизныеМарки.Ссылка
	                      |				И ТТНВходящаяЕГАИСТовары.Справка2 = ТТНВходящаяЕГАИСАкцизныеМарки.Справка2
	                      |	ГДЕ
	                      |		НЕ ЕСТЬNULL(ТТНВходящаяЕГАИСАкцизныеМарки.АкцизнаяМарка, 0) = 0
	                      |		И НЕ ТТНВходящаяЕГАИСТовары.АлкогольнаяПродукция = ЗНАЧЕНИЕ(Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.ПустаяСсылка)) КАК ТТНМарка
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	                      |		ПО ТТНМарка.ТТН = ПоступлениеТоваровТовары.Ссылка.ТТНВходящаяЕГАИС
	                      |			И ТТНМарка.АлкогольнаяПродукция = ПоступлениеТоваровТовары.АлкогольнаяПродукция
	                      |			И ТТНМарка.АкцизнаяМаркаНоменклатура <> ПоступлениеТоваровТовары.Номенклатура");
			
	Запрос.Параметры.Вставить("Дата",НачалоДня(ТекущаяДата() -60*60*24*15));	
			
	Результат	=	Запрос.Выполнить();	
	Выборка 	= Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
				
		АкцизнаяМаркаОбъект =  Выборка.АкцизнаяМарка.ПолучитьОбъект();
		
		АкцизнаяМаркаОбъект.Номенклатура = Выборка.НоменклатураПриход; 
		АкцизнаяМаркаОбъект.Записать();
		
		///////
	
		обТТНВходящая = Выборка.ТТН.ПолучитьОбъект();
		
		ПараметрыТаблицаТоваров.Вставить("Справка2", Выборка.Справка2);
					
		МассивСтрок = обТТНВходящая.Товары.НайтиСтроки(ПараметрыТаблицаТоваров);
			
		Если НЕ МассивСтрок.Количество() = 0 Тогда
			МассивСтрок[0].Номенклатура = Выборка.НоменклатураПриход;
		КонецЕсли;	 
		Попытка	
			обТТНВходящая.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;	
		   		
	КонецЦикла;	
	  	
КонецПроцедуры	

Процедура ПроставитьПризнакПредметаРасчетаВВидахНоменклатуры()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Ссылка,
	|	ВидыНоменклатуры.ОсобенностьУчета КАК ОсобенностьУчета,
	|	ВидыНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	ВидыНоменклатуры.ПризнакПредметаРасчета = ЗНАЧЕНИЕ(Справочник.ПризнакиПредметовРасчета.ПустаяСсылка)");
	
	Результат	=	Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		лОбъект	=Выборка.Ссылка.ПолучитьОбъект();	
		
		Если Выборка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
				
			Если Выборка.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукция
				ИЛИ Выборка.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция 
				ИЛИ Выборка.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.Пиво 
				ИЛИ Выборка.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.АльтернативныйТабак 
				ИЛИ Выборка.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво 
				ИЛИ Выборка.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.СоковаяПродукция Тогда
				лОбъект.ПризнакПредметаРасчета = Справочники.ПризнакиПредметовРасчета.ПодакцизныйТовар;
			Иначе
				лОбъект.ПризнакПредметаРасчета = Справочники.ПризнакиПредметовРасчета.Товар;
			КонецЕсли;
		Иначе
			лОбъект.ПризнакПредметаРасчета = Справочники.ПризнакиПредметовРасчета.Товар;
		КонецЕсли;
		
		Попытка
			лОбъект.Записать();
		Исключение
		КонецПопытки;	
		
	КонецЦикла;	
	    	
КонецПроцедуры	

Процедура ПроверитьЗаполнениеЦенниковВВидеНоменклатуры()

	УстановитьПривилегированныйРежим(Истина);
	Попытка     
		
		ШаблонЦенника = Справочники.ХранилищеШаблонов.НайтиПоНаименованию("Ценник");
		
		Если НЕ ЗначениеЗаполнено(ШаблонЦенника) Тогда
			Возврат;
		КонецЕсли;	
		
		ТабачнаяПродукция =Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Табачная продукция");
		
		Запрос = Новый Запрос;
		Запрос.Параметры.Вставить("ТабачнаяПродукция",ТабачнаяПродукция);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВидыНоменклатуры.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		               |ГДЕ
		               |	ВидыНоменклатуры.ШаблонЦенника = ЗНАЧЕНИЕ(Справочник.ХранилищеШаблонов.ПустаяСсылка)
		               |	И НЕ ВидыНоменклатуры.Ссылка = &ТабачнаяПродукция";
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.ШаблонЦенника = ШаблонЦенника;
			Об.Записать();
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(ТабачнаяПродукция) Тогда
			Если ЗначениеЗаполнено(ТабачнаяПродукция.ШаблонЦенника) Тогда
				ОБ = ТабачнаяПродукция.ПолучитьОбъект();
				Об.ШаблонЦенника = Неопределено;
				Об.Записать();
			КонецЕсли;	
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

