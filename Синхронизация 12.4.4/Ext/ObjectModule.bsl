Функция ПолучитьФизЛицоКассира()  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка    
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Пользователи.ФизическоеЛицо.Наименование КАК ФизЛицоКассира
		                      |ИЗ
		                      |	Справочник.Пользователи КАК Пользователи
		                      |ГДЕ
		                      |	 Пользователи.Наименование = &Наименование");
		
		Запрос.Параметры.Вставить("Наименование","Кассир"); 
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат "";
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		
		Возврат Выборка.ФизЛицоКассира;
		
	Исключение
	КонецПопытки;
	
КонецФункции		

Функция ПолучитьДатуПоследнейКопии()
	СтрокаСоединения = СтрЗаменить(СтрокаСоединенияИнформационнойБазы(), """", Символы.ПС);
	КаталогИнформационнойБазы = СтрПолучитьСтроку(СтрокаСоединения, 2);
			
	КаталогИнформационнойБазыДляБекапов =  КаталогИнформационнойБазы;
	ТрадПутьВыгрузкиРезервнойКопии = Константы.ТрадПутьВыгрузкиРезервнойКопии.Получить();
	Если ЗначениеЗаполнено(ТрадПутьВыгрузкиРезервнойКопии) Тогда
		КаталогИнформационнойБазыДляБекапов = ТрадПутьВыгрузкиРезервнойКопии;
	КонецЕсли;
	
	ИмяФайлаИнформационнойБазы = "1Cv8.1CD";
	
	ТаблицаФайлов = Новый ТаблицаЗначений;
	ТаблицаФайлов.Колонки.Добавить("ВремяИзменения", Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		
	НайденныеФайлы = НайтиФайлы(КаталогИнформационнойБазыДляБекапов, ИмяФайлаИнформационнойБазы + "-*.zip");
	Для каждого НайденныйФайл Из НайденныеФайлы Цикл
		Если НайденныйФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаФайлов.Добавить();
		НоваяСтрока.ВремяИзменения = НайденныйФайл.ПолучитьВремяИзменения();
	КонецЦикла;
	
	Если ТаблицаФайлов.Количество() > 0 Тогда
		ТаблицаФайлов.Сортировать("ВремяИзменения Убыв");
		Возврат ТаблицаФайлов[0].ВремяИзменения;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

