		ПивоВПотребительскихУпаковках 			= Перечисления.ОсобенностиУчетаНоменклатуры.ПивоВПотребительскихУпаковках;
				
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ВидыНоменклатуры.Ссылка КАК Ссылка,
		                      |	ВидыНоменклатуры.ПризнакПредметаРасчета КАК ПризнакПредметаРасчета,
		                      |	ВидыНоменклатуры.ОсобенностьУчета КАК ОсобенностьУчета
		                      |ИЗ
		                      |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		                      |ГДЕ
		                      |	ВидыНоменклатуры.Наименование = &Наименование");
		
		Запрос.Параметры.Вставить("Наименование","Пиво");
		
