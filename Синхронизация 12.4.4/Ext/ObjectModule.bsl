КонецПроцедуры
 
Процедура ПерезаполнитьТоварыПоДаннымПоставщикаПоФакту(ДокументПоступления)
	
	ДокументПоступления.ТоварыПоДаннымПоставщика.Очистить();
	КолонкиГруппы = "Номенклатура, Характеристика, Упаковка, Цена, СтавкаНДС, ХарактеристикиИспользуются,
					 |АлкогольнаяПродукция, ИдентификаторУпаковки, ИдентификаторСтроки";
	КолонкиПоказатели = "КоличествоУпаковок, Количество, Сумма, СуммаНДС";
	
	Товары = ДокументПоступления.Товары.Выгрузить(  , КолонкиГруппы + ", " + КолонкиПоказатели);
	Товары.Свернуть(КолонкиГруппы, КолонкиПоказатели);
	
	Для каждого ТекСтрока Из Товары Цикл
		НоваяСтрока = ДокументПоступления.ТоварыПоДаннымПоставщика.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
	
	ОбработкаТабличнойЧастиТоварыКлиентСервер.ЗаполнитьСуммуВсегоВТаблице(ДокументПоступления.ТоварыПоДаннымПоставщика, ДокументПоступления.ЦенаВключаетНДС);
