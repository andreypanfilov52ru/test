	ТаблицаВозвратов.Колонки.Добавить("ПоставщикКПП", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
	ТаблицаВозвратов.Колонки.Добавить("ДатаВхТТН", Новый ОписаниеТипов("Дата"));
	ТаблицаВозвратов.Колонки.Добавить("НомерВхТТН", Новый ОписаниеТипов("Строка"));
	ТаблицаВозвратов.Колонки.Добавить("ТТН_ЕГАИС", Новый ОписаниеТипов("Строка"));
	ТаблицаВозвратов.Колонки.Добавить("СтатусТТН_ЕГАИС", Новый ОписаниеТипов("Строка"));
	ТаблицаВозвратов.Колонки.Добавить("СделкаЗавершена", Новый ОписаниеТипов("Булево"));
	ТаблицаВозвратов.Колонки.Добавить("СуммаДокумента", Новый ОписаниеТипов("Число"));
	ТаблицаВозвратов.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаВозвратов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаВозвратов.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаВозвратов.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблицаВозвратов.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаВозвратов.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("Строка"));
	ТаблицаВозвратов.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	ТаблицаВозвратов.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВозвратТоваровПоставщикуТовары.Ссылка КАК Ссылка,
	               |	ВозвратТоваровПоставщикуТовары.НомерСтроки КАК НомерСтроки,
	               |	ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
	               |	ВозвратТоваровПоставщикуТовары.Количество КАК Количество,
	               |	ВозвратТоваровПоставщикуТовары.Ссылка.СуммаДокумента КАК СуммаДокумента,
	               |	ВозвратТоваровПоставщикуТовары.Цена КАК Цена,
	               |	ВозвратТоваровПоставщикуТовары.Сумма КАК Сумма,
	               |	ВозвратТоваровПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
	               |	ВозвратТоваровПоставщикуТовары.СуммаНДС КАК СуммаНДС,
	               |	ВозвратТоваровПоставщикуТовары.Ссылка.Дата КАК Дата,
	               |	ВозвратТоваровПоставщикуТовары.Ссылка.Номер КАК Номер,
	               |	ЕСТЬNULL(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника, """") КАК СсылкаПриемник,
	               |	ВозвратТоваровПоставщикуТовары.Ссылка.Проведен КАК Проведен,
	               |	""Документ.ВозвратТоваровПоставщику"" КАК ТипСсылки,
	               |	"""" КАК СтатусТТН_ЕГАИС,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Ссылка.ТТНИсходящаяЕГАИС.ИдентификаторЕГАИС, """") КАК ТТН_ЕГАИС,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Ссылка.ДокументОснование.НомерВходящегоДокумента, """") КАК НомерВхТТН,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Ссылка.ДокументОснование.ДатаВходящегоДокумента, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВхТТН,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Ссылка.Контрагент.ИНН, """") КАК ПоставщикИНН,
	               |	ЕСТЬNULL(ВозвратТоваровПоставщикуТовары.Ссылка.Контрагент.КПП, """") КАК ПоставщикКПП,
	               |	ИСТИНА КАК СделкаЗавершена
	               |ИЗ
	               |	Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Изменения КАК ВозвратТоваровПоставщикуИзменения
	               |		ПО ВозвратТоваровПоставщикуТовары.Ссылка = ВозвратТоваровПоставщикуИзменения.Ссылка
	               |			И (ВозвратТоваровПоставщикуИзменения.Узел = &Узел)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	               |		ПО ВозвратТоваровПоставщикуТовары.Ссылка = СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника
	               |			И (СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &Узел)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка,
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаВозвратов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, , "Ссылка, Номенклатура, СтавкаНДС");
		НоваяСтрока.Ссылка = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		НоваяСтрока.Номенклатура = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
		Если ЗначениеЗаполнено(Выборка.СтавкаНДС) Тогда
			НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка().Метаданные().ЗначенияПеречисления[Перечисления.СтавкиНДС.Индекс(Выборка.СтавкаНДС)].Имя;
		Иначе
			НоваяСтрока.СтавкаНДС = "БезНДС";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаВозвратов;
КонецФункции

Функция ПолучитьОстатокПоКассеНаЧисло(пДата)
	 	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ДС.СуммаОстаток) КАК СуммаОстаток
	                      |ИЗ
	                      |	РегистрНакопления.ДенежныеСредстваНаличные.Остатки(&Дата, ) КАК ДС");
						  
				  
						  
	Запрос.Параметры.Вставить("Дата",пДата);					  
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
	Иначе	
		Выборка  = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.СуммаОстаток;		
	КонецЕсли;
	       	
КонецФункции	

Функция ПолучитьДанныеПоОшибкамБД(Узел)
	
	лКассаККМ = Справочники.КассыККМ.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КассыККМ.Ссылка
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	НЕ КассыККМ.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("", );
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		лКассаККМ = Выборка.Ссылка;
	КонецЕсли;
	  	  	
	ТаблицаОшибокБД = Новый ТаблицаЗначений;
	ТаблицаОшибокБД.Колонки.Добавить("УникальныйИдентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаОшибокБД.Колонки.Добавить("ТипСсылки", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаОшибокБД.Колонки.Добавить("ПредставлениеОбъекта", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаОшибокБД.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка"));
	ТаблицаОшибокБД.Колонки.Добавить("ОписаниеОшибки", Новый ОписаниеТипов("Строка"));
	ТаблицаОшибокБД.Колонки.Добавить("ДатаСобытия", Новый ОписаниеТипов("Дата"));
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("ДатаПозавчера",НачалоДня(ТекущаяДата() - 86400*2));
	Запрос.Параметры.Вставить("ДатаВчера",НачалоДня(ТекущаяДата() - 86400));
	Запрос.Параметры.Вставить("Дата",НачалоДня(ТекущаяДата() - 86400*30));
	Запрос.Параметры.Вставить("ПустаяДата",Дата(1,1,1));
	Запрос.Параметры.Вставить("КассаККМ",лКассаККМ);
	Запрос.УстановитьПараметр("Узел", Узел);
    Запрос.УстановитьПараметр("Ответственный", Справочники.Пользователи.Автомат);
	
	//Передача в регистр 2
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПередачаВРегистр2ЕГАИС.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ табПередачаВРегистр2
	               |ИЗ
	               |	Документ.ПередачаВРегистр2ЕГАИС КАК ПередачаВРегистр2ЕГАИС
	               |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	               |		ПО ПередачаВРегистр2ЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
	               |ГДЕ
	               |	ПередачаВРегистр2ЕГАИС.Дата >= &ДатаВчера
	               |	И ПередачаВРегистр2ЕГАИС.Проведен
	               |	И (СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиПередачиВРегистр2ЕГАИС.ОшибкаПередачи)
	               |			ИЛИ СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиПередачиВРегистр2ЕГАИС.ОшибкаПроведенияЕГАИС))
	               |	И ПередачаВРегистр2ЕГАИС.Ответственный = &Ответственный
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕГАИСПрисоединенныеФайлы.Документ КАК Документ,
	               |	ЕГАИСПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
	               |	ЕГАИСПрисоединенныеФайлы.Ссылка КАК ЕГАИСПрисоединенныеФайлыСсылка
	               |ПОМЕСТИТЬ табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы
	               |ИЗ
	               |	табПередачаВРегистр2 КАК табПередачаВРегистр2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕГАИСПрисоединенныеФайлы КАК ЕГАИСПрисоединенныеФайлы
	               |		ПО табПередачаВРегистр2.Ссылка = ЕГАИСПрисоединенныеФайлы.Документ
	               |ГДЕ
	               |	ЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыЗапросовИС.Входящий)
	               |	И ЕГАИСПрисоединенныеФайлы.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.КвитанцияПроведенЕГАИС)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	""Документ.ПередачаВРегистр2ЕГАИС"" КАК ТипСсылки,
	               |	табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.Документ КАК Ссылка,
	               |	табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.Документ.Представление КАК ПредставлениеОбъекта,
	               |	""Ошибка передачи в ЕГАИС"" КАК Ошибка,
	               |	табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.Документ.Дата КАК ДатаСобытия,
	               |	табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.ЕГАИСПрисоединенныеФайлыСсылка.Описание КАК ОписаниеОшибки
	               |ИЗ
	               |	табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы КАК табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.Документ КАК Документ,
	               |			МАКСИМУМ(табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.ДатаСоздания) КАК ДатаСоздания
	               |		ИЗ
	               |			табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы КАК табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.Документ) КАК ЕГАИСДатыПоследнихСообщений
	               |		ПО табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.Документ = ЕГАИСДатыПоследнихСообщений.Документ
	               |			И табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы.ДатаСоздания = ЕГАИСДатыПоследнихСообщений.ДатаСоздания
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ табПередачаВРегистр2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ табПередачаВРегистр2ЕГАИСПрисоединенныеФайлы";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаОшибокБД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.УникальныйИдентификатор = ?(Выборка.Ссылка = НЕОПРЕДЕЛЕНО,"",Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;

	//Акт списания ЕГАИС
	
	Запрос.Текст = "ВЫБРАТЬ
		               |	АктСписанияЕГАИС.Ссылка КАК Ссылка
		               |ПОМЕСТИТЬ табАктСписанияЕГАИС
		               |ИЗ
		               |	Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
		               |		ПО АктСписанияЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
		               |ГДЕ
		               |	АктСписанияЕГАИС.Дата >= &Дата
		               |	И АктСписанияЕГАИС.Проведен
		               |	И (СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиАктаСписанияЕГАИС.ОшибкаПередачи)
		               |			ИЛИ СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиАктаСписанияЕГАИС.ОшибкаПроведенияЕГАИС))
		               |	И АктСписанияЕГАИС.Ответственный = &Ответственный
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЕГАИСПрисоединенныеФайлы.Документ КАК Документ,
		               |	ЕГАИСПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
		               |	ЕГАИСПрисоединенныеФайлы.Ссылка КАК ЕГАИСПрисоединенныеФайлыСсылка
		               |ПОМЕСТИТЬ табАктСписанияЕГАИСПрисоединенныеФайлы
		               |ИЗ
		               |	табАктСписанияЕГАИС КАК табАктСписанияЕГАИС
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕГАИСПрисоединенныеФайлы КАК ЕГАИСПрисоединенныеФайлы
		               |		ПО табАктСписанияЕГАИС.Ссылка = ЕГАИСПрисоединенныеФайлы.Документ
		               |ГДЕ
		               |	ЕГАИСПрисоединенныеФайлы.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыЗапросовИС.Входящий)
		               |	И ЕГАИСПрисоединенныеФайлы.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.КвитанцияПроведенЕГАИС)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	""Документ.АктСписанияЕГАИС"" КАК ТипСсылки,
		               |	табАктСписанияЕГАИСПрисоединенныеФайлы.Документ КАК Ссылка,
		               |	табАктСписанияЕГАИСПрисоединенныеФайлы.Документ.Представление КАК ПредставлениеОбъекта,
		               |	""Ошибка передачи в ЕГАИС"" КАК Ошибка,
		               |	табАктСписанияЕГАИСПрисоединенныеФайлы.Документ.Дата КАК ДатаСобытия,
		               |	табАктСписанияЕГАИСПрисоединенныеФайлы.ЕГАИСПрисоединенныеФайлыСсылка.Описание КАК ОписаниеОшибки
		               |ИЗ
		               |	табАктСписанияЕГАИСПрисоединенныеФайлы КАК табАктСписанияЕГАИСПрисоединенныеФайлы
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		               |			табАктСписанияЕГАИСПрисоединенныеФайлы.Документ КАК Документ,
		               |			МАКСИМУМ(табАктСписанияЕГАИСПрисоединенныеФайлы.ДатаСоздания) КАК ДатаСоздания
		               |		ИЗ
		               |			табАктСписанияЕГАИСПрисоединенныеФайлы КАК табАктСписанияЕГАИСПрисоединенныеФайлы
		               |		
		               |		СГРУППИРОВАТЬ ПО
		               |			табАктСписанияЕГАИСПрисоединенныеФайлы.Документ) КАК ЕГАИСДатыПоследнихСообщений
		               |		ПО табАктСписанияЕГАИСПрисоединенныеФайлы.Документ = ЕГАИСДатыПоследнихСообщений.Документ
		               |			И табАктСписанияЕГАИСПрисоединенныеФайлы.ДатаСоздания = ЕГАИСДатыПоследнихСообщений.ДатаСоздания
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |УНИЧТОЖИТЬ табАктСписанияЕГАИС
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |УНИЧТОЖИТЬ табАктСписанияЕГАИСПрисоединенныеФайлы";

	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаОшибокБД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.УникальныйИдентификатор = ?(Выборка.Ссылка = НЕОПРЕДЕЛЕНО,"",Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;
	
	Запрос.Текст = ("ВЫБРАТЬ
	                |	""Документ.ОтчетОРозничныхПродажах"" КАК ТипСсылки,
	                |	НЕОПРЕДЕЛЕНО КАК Ссылка,
	                |	""Не определено"" КАК ПредставлениеОбъекта,
	                |	""Не создана выемка или требуется пересчитать итоги"" КАК Ошибка,
	                |	&ПустаяДата КАК ДатаСобытия
	                |ИЗ
	                |	РегистрНакопления.ДенежныеСредстваККМ.Остатки(&ДатаПозавчера, КассаККМ = &КассаККМ) КАК ДенежныеСредстваККМОстатки
	                |ГДЕ
	                |	ДенежныеСредстваККМОстатки.СуммаОстаток <> 0
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	""Документ.ОтчетОРозничныхПродажах"",
	                |	ЧекККМ.ОтчетОРозничныхПродажах,
	                |	НАЧАЛОПЕРИОДА(ЧекККМ.Дата, ДЕНЬ),
	                |	""Битая ссылка"",
	                |	&ПустаяДата
	                |ИЗ
	                |	Документ.ЧекККМ КАК ЧекККМ
	                |ГДЕ
	                |	НЕ ЧекККМ.ОтчетОРозничныхПродажах ЕСТЬ NULL
	                |	И ЧекККМ.ОтчетОРозничныхПродажах <> ЗНАЧЕНИЕ(Документ.ОтчетОРозничныхПродажах.ПустаяСсылка)
	                |	И ЧекККМ.ОтчетОРозничныхПродажах.Номер ЕСТЬ NULL
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	НАЧАЛОПЕРИОДА(ЧекККМ.Дата, ДЕНЬ),
	                |	ЧекККМ.ОтчетОРозничныхПродажах
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	""Документ.ОтчетОРозничныхПродажах"",
	                |	ОтчетОРозничныхПродажах.Ссылка,
	                |	ОтчетОРозничныхПродажах.Представление,
	                |	""Не проведен"",
	                |	ОтчетОРозничныхПродажах.Дата
	                |ИЗ
	                |	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	                |ГДЕ
	                |	ОтчетОРозничныхПродажах.Дата >= &Дата
	                |	И НЕ ОтчетОРозничныхПродажах.Проведен
	                |	И НЕ ОтчетОРозничныхПродажах.ПометкаУдаления
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	""Документ.ПередачаВРегистр2ЕГАИС"",
	                |	ПередачаВРегистр2ЕГАИС.Ссылка,
	                |	ПередачаВРегистр2ЕГАИС.Представление,
	                |	""Ошибка формирования документа"",
	                |	ПередачаВРегистр2ЕГАИС.Дата
	                |ИЗ
	                |	Документ.ПередачаВРегистр2ЕГАИС КАК ПередачаВРегистр2ЕГАИС
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	                |		ПО ПередачаВРегистр2ЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
	                |ГДЕ
	                |	ПередачаВРегистр2ЕГАИС.Дата >= &ДатаВчера
	                |	И ПередачаВРегистр2ЕГАИС.Проведен
	                |	И СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиПередачиВРегистр2ЕГАИС.Черновик)
	                |	И ПередачаВРегистр2ЕГАИС.Ответственный = &Ответственный
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	""Документ.АктСписанияЕГАИС"",
	                |	АктСписанияЕГАИС.Ссылка,
	                |	АктСписанияЕГАИС.Представление,
	                |	""Ошибка записи Акта списания"",
	                |	АктСписанияЕГАИС.Дата
	                |ИЗ
	                |	Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
	                |ГДЕ
	                |	АктСписанияЕГАИС.Дата >= &Дата
	                |	И НЕ АктСписанияЕГАИС.ПометкаУдаления
	                |	И НЕ АктСписанияЕГАИС.Проведен
	                |	И АктСписанияЕГАИС.Ответственный = &Ответственный");
	
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаОшибокБД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.УникальныйИдентификатор = ?(Выборка.Ссылка = НЕОПРЕДЕЛЕНО,"",Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;
	
	Возврат ТаблицаОшибокБД;
	
КонецФункции	

Функция ПолучитьТаблицуАкцизныхМарокЕГАИС()
	
	СтруктураВозврата = Новый Структура("ЕстьДанныеПомаркам,ТаблицаАкцизныеМаркиЕГАИС");
	
	ТаблицаАкцизныеМаркиЕГАИС = Новый ТаблицаЗначений;
	ТаблицаАкцизныеМаркиЕГАИС.Колонки.Добавить("АкцизнаяМарка"			, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200)));
	ТаблицаАкцизныеМаркиЕГАИС.Колонки.Добавить("Номенклатура"			, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(36)));
	ТаблицаАкцизныеМаркиЕГАИС.Колонки.Добавить("АлкогольнаяПродукцияКод", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(50)));
	ТаблицаАкцизныеМаркиЕГАИС.Колонки.Добавить("Справка1"				, Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(128)));
	ТаблицаАкцизныеМаркиЕГАИС.Колонки.Добавить("Справка2"				, Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(128)));

				
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	АкцизныеМаркиЕГАИС.АкцизнаяМарка.ЗначениеШтрихкода КАК АкцизнаяМарка,
	                      |	АкцизныеМаркиЕГАИС.АкцизнаяМарка.Номенклатура КАК Номенклатура,
	                      |	АкцизныеМаркиЕГАИС.АлкогольнаяПродукция.Код КАК АлкогольнаяПродукцияКод,
	                      |	АкцизныеМаркиЕГАИС.Справка2.НомерСправки1 КАК Справка1,
	                      |	АкцизныеМаркиЕГАИС.Справка2.Наименование КАК Справка2
	                      |ИЗ
	                      |	РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	                      |ГДЕ
	                      |	АкцизныеМаркиЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыАкцизныхМарок.ВНаличии)");
	
	
	Результат = Запрос.Выполнить(); 
	
	СтруктураВозврата.ЕстьДанныеПомаркам =  НЕ Результат.Пустой();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаАкцизныеМаркиЕГАИС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Попытка
			НоваяСтрока.Номенклатура = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
		Исключение
		КонецПопытки;	
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ТаблицаАкцизныеМаркиЕГАИС);
	
	СтруктураВозврата.ТаблицаАкцизныеМаркиЕГАИС =  ЗаписьXML.Закрыть();
		
	Возврат СтруктураВозврата;
	
КонецФункции	

Функция ПолучитьКоличествоНоменклатуры()
					
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК Количество
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура");
	
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции


Функция ПолучитьОстаткиЕГАИС()
	
	// Только пиво
	
	ТаблицаОстаткиЕГАИС = Новый ТаблицаЗначений;
	ТаблицаОстаткиЕГАИС.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаОстаткиЕГАИС.Колонки.Добавить("ВидРегистра", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(12)));
	ТаблицаОстаткиЕГАИС.Колонки.Добавить("КодНоменклатуры", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(50) ));
	ТаблицаОстаткиЕГАИС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
				
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка КАК Ссылка,
	                      |	НАЧАЛОПЕРИОДА(ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.Дата, ДЕНЬ) КАК Дата,
	                      |	ВЫБОР
	                      |		КОГДА ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.ЗапросОстатковВРегистре1)
	                      |			ТОГДА ""Регистр1""
	                      |		КОГДА ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.ЗапросОстатковВРегистре2)
	                      |			ТОГДА ""Регистр2""
	                      |		ИНАЧЕ ""НЕОПРЕДЕЛЕНО""
	                      |	КОНЕЦ КАК ВидРегистра,
	                      |	ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.АлкогольнаяПродукция.Код КАК КодНоменклатуры,
	                      |	СУММА(ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Количество) КАК Количество
	                      |ИЗ
	                      |	Документ.ОстаткиЕГАИС.ОстаткиПоДаннымЕГАИС КАК ОстаткиЕГАИСОстаткиПоДаннымЕГАИС
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	                      |		ПО ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			НАЧАЛОПЕРИОДА(ОстаткиЕГАИС.Дата, ДЕНЬ) КАК ДатаДень,
	                      |			МАКСИМУМ(ОстаткиЕГАИС.Дата) КАК ДатаДокумента,
	                      |			ОстаткиЕГАИС.ВидДокумента КАК ВидДокумента
	                      |		ИЗ
	                      |			Документ.ОстаткиЕГАИС КАК ОстаткиЕГАИС
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	                      |				ПО ОстаткиЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
	                      |		ГДЕ
	                      |			НЕ ОстаткиЕГАИС.Ссылка.ПометкаУдаления
	                      |			И ОстаткиЕГАИС.Ссылка.Дата >= &ДатаВыгрузки
	                      |			И СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиОстатковЕГАИС.ПолученыОстатки)
	                      |			И ОстаткиЕГАИС.Ссылка.Ответственный = &Ответственный
	                      |		
	                      |		СГРУППИРОВАТЬ ПО
	                      |			НАЧАЛОПЕРИОДА(ОстаткиЕГАИС.Дата, ДЕНЬ),
	                      |			ОстаткиЕГАИС.ВидДокумента) КАК ПараметрыДокументовОстатков
	                      |		ПО ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.ВидДокумента = ПараметрыДокументовОстатков.ВидДокумента
	                      |			И ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.Дата = ПараметрыДокументовОстатков.ДатаДокумента
	                      |ГДЕ
	                      |	НЕ ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.ПометкаУдаления
	                      |	И ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.Дата >= &ДатаВыгрузки
	                      |	И СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиОстатковЕГАИС.ПолученыОстатки)
	                      |	И ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.Ответственный = &Ответственный
	                      |	И НЕ ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.АлкогольнаяПродукция.ВидПродукции.Маркируемый
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка,
	                      |	НАЧАЛОПЕРИОДА(ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.Дата, ДЕНЬ),
	                      |	ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.АлкогольнаяПродукция.Код,
	                      |	ВЫБОР
	                      |		КОГДА ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.ЗапросОстатковВРегистре1)
	                      |			ТОГДА ""Регистр1""
	                      |		КОГДА ОстаткиЕГАИСОстаткиПоДаннымЕГАИС.Ссылка.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.ЗапросОстатковВРегистре2)
	                      |			ТОГДА ""Регистр2""
	                      |		ИНАЧЕ ""НЕОПРЕДЕЛЕНО""
	                      |	КОНЕЦ");
	
	Запрос.Параметры.Вставить("ДатаВыгрузки", НачалоДня(ТекущаяДата() - 86400*3));
	Запрос.Параметры.Вставить("Ответственный", Справочники.Пользователи.Автомат);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаОстаткиЕГАИС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаОстаткиЕГАИС;
	
КонецФункции	

Функция СформироватьДанныеСверкиСРозничнымиТочкамиТрадицияКонецВчерашнегоДня()  
	
	СтруктураСверки = Новый Структура();
				
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ТоварыНаСкладахОстатки.Номенклатура)) КАК Идентификатор,
	                      |	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаФормирования, ) КАК ТоварыНаСкладахОстатки");
	
	Запрос.Параметры.Вставить("ДатаФормирования", КонецДня(НачалоДня(ТекущаяДата())-1));
	
	СтруктураСверки.Вставить("ОстаткиТоваров",Запрос.Выполнить().Выгрузить());	
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьJSON(ЗаписьJSON, СтруктураСверки, НазначениеТипаXML.Явное);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Возврат  СтрокаJSON;
	
КонецФункции	

Функция ПолучитьСписокВнешнихОтчетовИОброботок()
	
	ТаблицаДополнительныеОтчетыИОбработки = Новый ТаблицаЗначений;
	ТаблицаДополнительныеОтчетыИОбработки.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
	ТаблицаДополнительныеОтчетыИОбработки.Колонки.Добавить("Версия", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(10)));
	ТаблицаДополнительныеОтчетыИОбработки.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(50)));
	ТаблицаДополнительныеОтчетыИОбработки.Колонки.Добавить("ИмяОбъекта", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(256)));
	ТаблицаДополнительныеОтчетыИОбработки.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(260)));
				
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ДополнительныеОтчетыИОбработки.Наименование КАК Наименование,
	                      |	ДополнительныеОтчетыИОбработки.Версия КАК Версия,
	                      |	ПРЕДСТАВЛЕНИЕ(ДополнительныеОтчетыИОбработки.Вид) КАК Вид,
	                      |	ДополнительныеОтчетыИОбработки.ИмяОбъекта КАК ИмяОбъекта,
	                      |	ДополнительныеОтчетыИОбработки.ИмяФайла КАК ИмяФайла
	                      |ИЗ
	                      |	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
	                      |ГДЕ
	                      |	ДополнительныеОтчетыИОбработки.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)");
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаДополнительныеОтчетыИОбработки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ТаблицаДополнительныеОтчетыИОбработки;
	
КонецФункции	

