	Попытка                                       
		//Рабочий контур
		WSОпределения = Новый WSОпределения("https://web.garm.ru/tradition/ws/retail.1cws" + "?wsdl","robot","pwd123321"); 
		
		//Тестовый контур	
		//WSОпределения = Новый WSОпределения("https://web.garm.ru/TRD/tradition_andrey/ws/retail.1cws" + "?wsdl","robot","pwd123321");   
				
		
		WSСервис = WSОпределения.Сервисы[0];
