Процедура ПроверитьСоздатьВыемкуНаОснованииПоследнегоОРП()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ОтчетОРозничныхПродажах.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	                      |ГДЕ
	                      |	ОтчетОРозничныхПродажах.Проведен
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ОтчетОРозничныхПродажах.Дата УБЫВ");
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
	    Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	лОтчетОРозничныхПродажах = Выборка.Ссылка;
	
	ВыемкиДС = Документы.ВыемкаДенежныхСредствИзКассыККМ.ПолучитьВыемкиДСОтчетаОРозничныхПродажах(лОтчетОРозничныхПродажах);
	
	Если НЕ ВыемкиДС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СуммаВыемки = ПолучитьСуммуВыемкиОтчета(лОтчетОРозничныхПродажах);
    Если СуммаВыемки = 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	ДополнительныеПараметры = Новый Структура;
	
	Попытка                                                                                                                 
		
		Отказ = Истина;
		
		ДокументВыемкаДенежныхСредствСсылка = ДенежныеСредстваВызовСервера.СоздатьДокументВыемкаДенежныхСредствИзКассыККМ(Отказ,
				СуммаВыемки,
				лОтчетОРозничныхПродажах.КассаККМ,
				лОтчетОРозничныхПродажах.Ссылка,
				ДополнительныеПараметры
		        );
	
	Исключение			
	КонецПопытки;			
				
КонецПроцедуры	

