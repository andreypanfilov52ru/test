	Запрос.УстановитьПараметр("Ссылка", пОтчетОРозничныхПродажах);
	Запрос.УстановитьПараметр("СуммаДокумента", пОтчетОРозничныхПродажах.СуммаДокумента);
	Запрос.УстановитьПараметр("ОплатаПодарочнымиСертификатами", пОтчетОРозничныхПродажах.ОплатаПодарочнымиСертификатами);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СуммаВыемки = 0;
	Если Выборка.Следующий() Тогда
		СуммаВыемки = Выборка.Сумма;
	КонецЕсли;
	
	Возврат СуммаВыемки;
	
КонецФункции

