		Пока Выборка.Следующий() Цикл  
						
			Если НЕ Выборка.ПризнакПредметаРасчета =  ПодакцизныйТоварМаркируемыйСИИмеющийКМ 
				ИЛИ НЕ Выборка.ОсобенностьУчета =  ПивоВПотребительскихУпаковках	 Тогда
				
				ТПОбъект =  Выборка.Ссылка.ПолучитьОбъект(); 
				ТПОбъект.ПризнакПредметаРасчета = ПодакцизныйТоварМаркируемыйСИИмеющийКМ; 
				ТПОбъект.ОсобенностьУчета 		= ПивоВПотребительскихУпаковках;
				ТПОбъект.Записать();
				
			КонецЕсли;
			
		КонецЦикла;	
			
	Исключение
	КонецПопытки;
	
КонецПроцедуры 

Процедура ПроверитьЗаполнениеОсобенностиУчётаПиво()

УстановитьПривилегированныйРежим(Истина);
	
	Попытка    
		
		ВидНоменклатурыПиво					 	= Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Пиво");
		ПивоВПотребительскихУпаковках 			= Перечисления.ОсобенностиУчетаНоменклатуры.ПивоВПотребительскихУпаковках; 
		ТипНоменклатурыТовар					= Перечисления.ТипыНоменклатуры.Товар;		
				
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Номенклатура.Ссылка КАК Ссылка,
		                      |	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
		                      |	Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
		                      |	Номенклатура.ОсобенностьУчета КАК ОсобенностьУчета
		                      |ИЗ
		                      |	Справочник.Номенклатура КАК Номенклатура
		                      |ГДЕ
		                      |	Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		                      |	И Номенклатура.ТипНоменклатуры = &ТипНоменклатуры
		                      |	И Номенклатура.ОсобенностьУчета <> &ОсобенностьУчета");
		
		Запрос.Параметры.Вставить("ВидНоменклатуры",ВидНоменклатурыПиво);
		Запрос.Параметры.Вставить("ТипНоменклатуры",ТипНоменклатурыТовар);
        Запрос.Параметры.Вставить("ОсобенностьУчета",ПивоВПотребительскихУпаковках);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл  
							
			ТПОбъект = Выборка.Ссылка.ПолучитьОбъект(); 
			ТПОбъект.ОсобенностьУчета = ПивоВПотребительскихУпаковках;
			ТПОбъект.Записать();
							
		КонецЦикла;	
			
	Исключение
	КонецПопытки;	
	
КонецПроцедуры	

Процедура ЗаполнитьОписаниеGTINИСПиво() 
	
	УстановитьПривилегированныйРежим(Истина);  
	
	Попытка
				
		ВидНоменклатуры = справочники.ВидыНоменклатуры.НайтиПоНаименованию("Пиво");
		
