Функция ПолучитьДанныеПоступлений(Узел)
	ТаблицаПоступлений = Новый ТаблицаЗначений;
	ТаблицаПоступлений.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаПоступлений.Колонки.Добавить("ТипСсылки", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаПоступлений.Колонки.Добавить("СсылкаПриемник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаПоступлений.Колонки.Добавить("ПоставщикИНН", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12)));
	ТаблицаПоступлений.Колонки.Добавить("ПоставщикКПП", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
	ТаблицаПоступлений.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаПоступлений.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблицаПоступлений.Колонки.Добавить("НомерВх", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	ТаблицаПоступлений.Колонки.Добавить("ДатаВх", Новый ОписаниеТипов("Дата"));
	ТаблицаПоступлений.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаПоступлений.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаПоступлений.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаПоступлений.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблицаПоступлений.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаПоступлений.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеТоваровТовары.Ссылка КАК Ссылка,
	               |	ПоступлениеТоваровТовары.Ссылка.Контрагент.ИНН КАК ПоставщикИНН,
	               |	ПоступлениеТоваровТовары.Ссылка.Контрагент.КПП КАК ПоставщикКПП,
	               |	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
	               |	ПоступлениеТоваровТовары.Количество КАК Количество,
	               |	ПоступлениеТоваровТовары.Цена КАК Цена,
	               |	ПоступлениеТоваровТовары.Сумма КАК Сумма,
	               |	ПоступлениеТоваровТовары.Ссылка.ДатаВходящегоДокумента КАК ДатаВх,
	               |	ПоступлениеТоваровТовары.Ссылка.НомерВходящегоДокумента КАК НомерВх,
	               |	ПоступлениеТоваровТовары.Ссылка.Дата КАК Дата,
	               |	ПоступлениеТоваровТовары.НомерСтроки КАК НомерСтроки,
	               |	ЕСТЬNULL(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника, """") КАК СсылкаПриемник,
	               |	""Документ.ПоступлениеТоваров"" КАК ТипСсылки,
	               |	ПоступлениеТоваровТовары.Ссылка.Проведен КАК Проведен,
	               |	ПоступлениеТоваровТовары.Ссылка.Номер КАК Номер
	               |ИЗ
	               |	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров.Изменения КАК ПоступлениеТоваровИзменения
	               |		ПО ПоступлениеТоваровТовары.Ссылка = ПоступлениеТоваровИзменения.Ссылка
	               |			И (ПоступлениеТоваровИзменения.Узел = &Узел)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	               |		ПО ПоступлениеТоваровТовары.Ссылка = СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника
	               |			И (СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &Узел)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка,
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаПоступлений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, , "Ссылка, Номенклатура");
		НоваяСтрока.Ссылка = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		НоваяСтрока.Номенклатура = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
	КонецЦикла;
	
	Возврат ТаблицаПоступлений;
КонецФункции

Функция ПолучитьДанныеРозничныхПродаж(Узел)
	ТаблицаПродаж = Новый ТаблицаЗначений;
	ТаблицаПродаж.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаПродаж.Колонки.Добавить("ТипСсылки", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	ТаблицаПродаж.Колонки.Добавить("СсылкаПриемник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаПродаж.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаПродаж.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблицаПродаж.Колонки.Добавить("СуммаДокумента", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("СуммаВозвратов", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("СуммаБезнал", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("ЭтоВозврат", Новый ОписаниеТипов("Булево"));
	ТаблицаПродаж.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	ТаблицаПродаж.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("КоличествоМарок", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("Строка"));
	ТаблицаПродаж.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	ТаблицаПродаж.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтчетОРозничныхПродажахИзменения.Ссылка КАК Ссылка,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.СуммаДокумента КАК СуммаДокумента,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.СуммаВозвратов КАК СуммаВозвратов,
	|	СУММА(ЕСТЬNULL(ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Сумма, 0)) КАК СуммаБезнал,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.Дата КАК Дата,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.Номер КАК Номер,
	|	ЕСТЬNULL(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника, """") КАК СсылкаПриемник,
	|	""Документ.ОтчетОРозничныхПродажах"" КАК ТипСсылки,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.Проведен КАК Проведен
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Изменения КАК ОтчетОРозничныхПродажахИзменения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРозничныхПродажах.ОплатаПлатежнымиКартами КАК ОтчетОРозничныхПродажахОплатаПлатежнымиКартами
	|		ПО ОтчетОРозничныхПродажахИзменения.Ссылка = ОтчетОРозничныхПродажахОплатаПлатежнымиКартами.Ссылка
	|			И (ОтчетОРозничныхПродажахИзменения.Узел = &Узел)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|		ПО ОтчетОРозничныхПродажахИзменения.Узел = СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы
	|			И ОтчетОРозничныхПродажахИзменения.Ссылка = СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника, """"),
	|	ОтчетОРозничныхПродажахИзменения.Ссылка,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.СуммаДокумента,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.СуммаВозвратов,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.Дата,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.Номер,
	|	ОтчетОРозничныхПродажахИзменения.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЧекККМТовары.Ссылка.ОтчетОРозничныхПродажах,
	|	ЧекККМТовары.Ссылка.ВидОперации,
	|	ЧекККМТовары.Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекККМАкцизныеМарки.КодАкцизнойМарки) КАК КоличествоМарок,
	|	ЧекККМТовары.Ссылка
	|ПОМЕСТИТЬ ДанныеЧеков
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЧекККМ.АкцизныеМарки КАК ЧекККМАкцизныеМарки
	|			ПО ЧекККМТовары.Ссылка = ЧекККМАкцизныеМарки.Ссылка
	|				И ЧекККМТовары.КлючСвязи = ЧекККМАкцизныеМарки.КлючСвязи
	|		ПО ДанныеДокумента.Ссылка = ЧекККМТовары.Ссылка.ОтчетОРозничныхПродажах
	|
	|СГРУППИРОВАТЬ ПО
	|	ЧекККМТовары.Номенклатура,
	|	ЧекККМТовары.Ссылка.ВидОперации,
	|	ЧекККМТовары.Ссылка.ОтчетОРозничныхПродажах,
	|	ЧекККМТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ОтчетТовары.НомерСтроки КАК НомерСтроки,
	|	ОтчетТовары.Номенклатура,
	|	ОтчетТовары.Характеристика,
	|	ОтчетТовары.Количество,
	|	ЕСТЬNULL(Марки.КоличествоМарок, 0) КАК КоличествоМарок,
	|	ДанныеДокумента.СуммаДокумента,
	|	ДанныеДокумента.СуммаВозвратов,
	|	ЛОЖЬ КАК ЭтоВозврат,
	|	ВЫБОР
	|		КОГДА ОтчетТовары.Количество = 0
	|			ТОГДА ОтчетТовары.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(ОтчетТовары.Сумма / ОтчетТовары.Количество КАК ЧИСЛО(10, 2))
	|	КОНЕЦ КАК Цена,
	|	ОтчетТовары.Сумма КАК Сумма,
	|	ОтчетТовары.СтавкаНДС,
	|	ОтчетТовары.СуммаНДС,
	|	ДанныеДокумента.Дата,
	|	ДанныеДокумента.Номер,
	|	ДанныеДокумента.СсылкаПриемник КАК СсылкаПриемник,
	|	ДанныеДокумента.ТипСсылки КАК ТипСсылки,
	|	ДанныеДокумента.Проведен,
	|	ДанныеДокумента.СуммаБезнал
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОтчетОРозничныхПродажахТовары.Ссылка КАК Ссылка,
	|			ОтчетОРозничныхПродажахТовары.Номенклатура КАК Номенклатура,
	|			ОтчетОРозничныхПродажахТовары.Характеристика КАК Характеристика,
	|			СУММА(ОтчетОРозничныхПродажахТовары.Количество) КАК Количество,
	|			СУММА(ОтчетОРозничныхПродажахТовары.Сумма) КАК Сумма,
	|			ОтчетОРозничныхПродажахТовары.СтавкаНДС КАК СтавкаНДС,
	|			СУММА(ОтчетОРозничныхПродажахТовары.СуммаНДС) КАК СуммаНДС,
	|			МИНИМУМ(ОтчетОРозничныхПродажахТовары.НомерСтроки) КАК НомерСтроки
	|		ИЗ
	|			Документ.ОтчетОРозничныхПродажах.Товары КАК ОтчетОРозничныхПродажахТовары
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ОтчетОРозничныхПродажахТовары.Ссылка,
	|			ОтчетОРозничныхПродажахТовары.Номенклатура,
	|			ОтчетОРозничныхПродажахТовары.СтавкаНДС,
	|			ОтчетОРозничныхПродажахТовары.Характеристика) КАК ОтчетТовары
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				ДанныеЧеков.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах,
	|				ДанныеЧеков.Номенклатура КАК Номенклатура,
	|				СУММА(ВЫБОР
	|						КОГДА ДанныеЧеков.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|							ТОГДА -ДанныеЧеков.КоличествоМарок
	|						ИНАЧЕ ДанныеЧеков.КоличествоМарок
	|					КОНЕЦ) КАК КоличествоМарок
	|			ИЗ
	|				ДанныеЧеков КАК ДанныеЧеков
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ДанныеЧеков.ОтчетОРозничныхПродажах,
	|				ДанныеЧеков.Номенклатура) КАК Марки
	|			ПО ОтчетТовары.Ссылка = Марки.ОтчетОРозничныхПродажах
	|				И ОтчетТовары.Номенклатура = Марки.Номенклатура
	|		ПО ДанныеДокумента.Ссылка = ОтчетТовары.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка,
	|	ВозвращенныеТовары.НомерСтроки,
	|	ВозвращенныеТовары.Номенклатура,
	|	ВозвращенныеТовары.Характеристика,
	|	ВозвращенныеТовары.Количество,
	|	ЕСТЬNULL(Марки.КоличествоМарок, 0),
	|	ДанныеДокумента.СуммаДокумента,
	|	ДанныеДокумента.СуммаВозвратов,
	|	ИСТИНА,
	|	ВЫБОР
	|		КОГДА ВозвращенныеТовары.Количество = 0
	|			ТОГДА ВозвращенныеТовары.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(ВозвращенныеТовары.Сумма / ВозвращенныеТовары.Количество КАК ЧИСЛО(10, 2))
	|	КОНЕЦ,
	|	ВозвращенныеТовары.Сумма,
	|	ВозвращенныеТовары.СтавкаНДС,
	|	ВозвращенныеТовары.СуммаНДС,
	|	ДанныеДокумента.Дата,
	|	ДанныеДокумента.Номер,
	|	ДанныеДокумента.СсылкаПриемник,
	|	ДанныеДокумента.ТипСсылки,
	|	ДанныеДокумента.Проведен,
	|	ДанныеДокумента.СуммаБезнал
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.Ссылка КАК Ссылка,
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.Номенклатура КАК Номенклатура,
	|			МИНИМУМ(ОтчетОРозничныхПродажахВозвращенныеТовары.НомерСтроки) КАК НомерСтроки,
	|			СУММА(ОтчетОРозничныхПродажахВозвращенныеТовары.Количество) КАК Количество,
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.Характеристика КАК Характеристика,
	|			СУММА(ОтчетОРозничныхПродажахВозвращенныеТовары.Сумма) КАК Сумма,
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.СтавкаНДС КАК СтавкаНДС,
	|			СУММА(ОтчетОРозничныхПродажахВозвращенныеТовары.СуммаНДС) КАК СуммаНДС
	|		ИЗ
	|			Документ.ОтчетОРозничныхПродажах.ВозвращенныеТовары КАК ОтчетОРозничныхПродажахВозвращенныеТовары
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.Номенклатура,
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.Характеристика,
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.Ссылка,
	|			ОтчетОРозничныхПродажахВозвращенныеТовары.СтавкаНДС) КАК ВозвращенныеТовары
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				ДанныеЧеков.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах,
	|				ДанныеЧеков.Номенклатура КАК Номенклатура,
	|				СУММА(ДанныеЧеков.КоличествоМарок) КАК КоличествоМарок
	|			ИЗ
	|				ДанныеЧеков КАК ДанныеЧеков
	|			ГДЕ
	|				ДанныеЧеков.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ДанныеЧеков.ОтчетОРозничныхПродажах,
	|				ДанныеЧеков.Номенклатура) КАК Марки
	|			ПО ВозвращенныеТовары.Ссылка = Марки.ОтчетОРозничныхПродажах
	|				И ВозвращенныеТовары.Номенклатура = Марки.Номенклатура
	|		ПО ДанныеДокумента.Ссылка = ВозвращенныеТовары.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ЭтоВозврат,
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ТаблицаПродаж.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, , "Ссылка, Номенклатура, СтавкаНДС");
		НоваяСтрока.Ссылка = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		НоваяСтрока.Номенклатура = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
		Попытка
			НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка().Метаданные().ЗначенияПеречисления[Перечисления.СтавкиНДС.Индекс(Выборка.СтавкаНДС)].Имя;
		Исключение
			НоваяСтрока.СтавкаНДС = "БезНДС";
		КонецПопытки;
	КонецЦикла;
	
	Возврат ТаблицаПродаж;
