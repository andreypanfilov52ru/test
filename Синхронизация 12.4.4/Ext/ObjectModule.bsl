Процедура ВыполнитьОбмен() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
		
	ПроверитьСоздатьВыемкуНаОснованииПоследнегоОРП();
	       	
	СоздатьКассовыеДокументы(); 
			
	ОбновитьКонстантуДатаПоследнегоОбмена();
	
	Узел = ПланыОбмена.РозницаСтандартАлко.ЭтотУзел();
	УзелЦентр = ПланыОбмена.РозницаСтандартАлко.НайтиПоКоду("ЦЕНТР");
	Если НЕ ЗначениеЗаполнено(УзелЦентр) Тогда
		Возврат;
	КонецЕсли;
	
	WSПрокси = ИнициализацияВебСервиса(УзелЦентр);
	Если WSПрокси = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("Регистрация", ВыгрузитьРегистрациюДанных(УзелЦентр));
	ПолучитьДанные(УзелЦентр, Данные);
	
	РезультатОбмена = WSПрокси.ВыполнитьОбмен(Узел.Код, Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(9)));
	Попытка
		ПолученныеДанные = РезультатОбмена.Получить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка загрузки номенклатуры: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ПолученныеДанные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;    
	
		
	ЗагрузитьРегистрациюДанных(ПолученныеДанные.Регистрация);
	ЗагрузитьДанныеДокументов(УзелЦентр, ПолученныеДанные.ДанныеДокументов);
	ЗагрузитьНоменклатуру(ПолученныеДанные);
	
	Если ПолученныеДанные.Свойство("ТребуетсяПроводитьСверкуДанныхСЕгаис") Тогда
		УстановитьМаркерТребуетсяПроводитьСверкуДанныхСЕгаис(ПолученныеДанные.ТребуетсяПроводитьСверкуДанныхСЕгаис);
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("КонтролироватьОстатокПриПроведении") Тогда
		УстановитьМаркерКонтролироватьОстатокПриПроведении(ПолученныеДанные.КонтролироватьОстатокПриПроведении);
	КонецЕсли;

		
	Если ПолученныеДанные.Свойство("ЗапрашиватьОстаткиЕгаис") Тогда
	     ЗапрашиватьОстаткиЕгаис = ПолученныеДанные.ЗапрашиватьОстаткиЕгаис;
	КонецЕсли;
		
	Если ПолученныеДанные.Свойство("РегМинимальныеЦены") Тогда
		ЗагрузитьРегистрМинимальныеЦены(ПолученныеДанные.РегМинимальныеЦены);
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("ДниЗапретаПродажАлкоголя") Тогда
		ЗагрузитьРегистрТрадДниЗапретаПродажиАлкоголя(ПолученныеДанные.ДниЗапретаПродажАлкоголя);
	КонецЕсли;	
	
	Если ПолученныеДанные.Свойство("ПропускатьОшибкиЕГАИСПриПечатиЧека") Тогда
		ЗагрузитьРегистрТрадПропускатьОшибкиЕГАИСПриПечатиЧека(ПолученныеДанные.ПропускатьОшибкиЕГАИСПриПечатиЧека);
	КонецЕсли;	
		
	Если ПолученныеДанные.Свойство("Поставщики") Тогда
		ЗагрузитьПоставщиков(ПолученныеДанные.Поставщики);
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("ДанныеПоставок") Тогда
		ЗагрузитьПоставки(ПолученныеДанные.ДанныеПоставок);
	КонецЕсли;
		
	Если ПолученныеДанные.Свойство("ЦеныНоменклатуры") Тогда
		ЗагрузитьЦены(ПолученныеДанные.ЦеныНоменклатуры);
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("ФайлыВнешнихОбработок") Тогда
		ЗаполнитьТаблицуФайлыВнешнихОбработок(ПолученныеДанные.ФайлыВнешнихОбработок);
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("ФайлРасширения") Тогда
		ЗагрузитьРасширение(ПолученныеДанные.ФайлРасширения);
	КонецЕсли;  
	
	Если ПолученныеДанные.Свойство("ПарольАдминистратораТТ") Тогда
		УстановитьПарольАдминистратораТТ(ПолученныеДанные.ПарольАдминистратораТТ);
	КонецЕсли;   
	
	//Кассир
	Если ПолученныеДанные.Свойство("ФизЛицоКассира") Тогда
		УстановитьФизЛицоКассира(ПолученныеДанные.ФизЛицоКассира);
	КонецЕсли; 
	
	УстановитьКонстантыТрадВремяПродаж(ПолученныеДанные); 
		
	    			
	КоличествоДнейРазрешения = 2;
	
	Если ПолученныеДанные.Свойство("КоличествоДнейРазрешения") Тогда
		КоличествоДнейРазрешения =  ПолученныеДанные.КоличествоДнейРазрешения;
	КонецЕсли;
		
	УстановитьДатуЗапретаРедактирования(КоличествоДнейРазрешения);
	ОбновитьКонстантуДатаПоследнегоУдачногоОбмена();
	ПроверитьНастройкиЕГАИС();
	
	НесоответсвиеНоменклатурыАкцизныхМарокИсправитьНоменклатуруВМарке();
	
	ПроставитьПризнакПредметаРасчетаВВидахНоменклатуры();
		
	ПроверитьЗаполнениеЦенниковВВидеНоменклатуры(); 
	
	//ПроверитьЗаполнениеПризнакПредметаРасчетаВВидеНоменклатурыТабачнаяПродукция();  
	//ПроверитьЗаполнениеПризнакПредметаРасчетаВВидеНоменклатурыПиво();
	ПроверитьЗаполнениеОсобенностиУчётаПиво();
	
	ЗаполнитьОписаниеGTINИСПиво(); 
	
	ЗаполнитьСтавку22();  
	
	УстановитьНастройкиРабочегоМестаКассира();
	
КонецПроцедуры 

Процедура ЗапроситьНоменклатуруПоКоду(КодНоменклатуры) Экспорт
	Узел = ПланыОбмена.РозницаСтандартАлко.ЭтотУзел();
	УзелЦентр = ПланыОбмена.РозницаСтандартАлко.НайтиПоКоду("ЦЕНТР");
	Если НЕ ЗначениеЗаполнено(УзелЦентр) Тогда
		Возврат;
	КонецЕсли;
	
	WSПрокси = ИнициализацияВебСервиса(УзелЦентр);
	Если WSПрокси = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбмена = WSПрокси.ПолучитьНоменклатуру(Узел.Код, КодНоменклатуры);
	Попытка
		ДанныеНоменклатуры = РезультатОбмена.Получить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка загрузки номенклатуры: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеНоменклатуры) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьНоменклатуру(ДанныеНоменклатуры);
	
КонецПроцедуры

