#КонецОбласти

#Область РаботаСДанными

Функция ПрочитатьНоменклатуру(Реквизиты, ВидыНоменклатуры)
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Идентификатор));
	Номенклатура = НоменклатураСсылка.ПолучитьОбъект();
	
	Если Номенклатура = Неопределено Тогда
		Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
		Номенклатура.УстановитьСсылкуНового(НоменклатураСсылка);
	КонецЕсли;
	
	КлассификаторСсылка = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(Реквизиты.КодЕГАИС);
	Если НЕ ЗначениеЗаполнено(КлассификаторСсылка) Тогда
		Классификатор = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент();
		Классификатор.Код = Реквизиты.КодЕГАИС;
		
		РеквизитыКлассификатор = Новый Структура;
		РеквизитыКлассификатор.Вставить("Наименование", Реквизиты.НаименованиеЕГАИС);
		РеквизитыКлассификатор.Вставить("Объем", Реквизиты.Объем);
		РеквизитыКлассификатор.Вставить("Крепость", Реквизиты.Крепость);
		РеквизитыКлассификатор.Вставить("Производитель", Справочники.КлассификаторОрганизацийЕГАИС.НайтиПоКоду(Реквизиты.КодПроизводителяЕГАИС));
		РеквизитыКлассификатор.Вставить("Импортер", ?(ПустаяСтрока(Реквизиты.КодИмпортераЕГАИС), Справочники.КлассификаторОрганизацийЕГАИС.ПустаяСсылка(), Справочники.КлассификаторОрганизацийЕГАИС.НайтиПоКоду(Реквизиты.КодИмпортераЕГАИС)));
		РеквизитыКлассификатор.Вставить("НаименованиеПолное", Реквизиты.НаименованиеЕГАИС);
		РеквизитыКлассификатор.Вставить("ВидПродукции", Справочники.ВидыАлкогольнойПродукции.НайтиПоКоду(Реквизиты.ВидПродукции));
		
		Для Каждого Реквизит Из РеквизитыКлассификатор Цикл
			Если Классификатор[Реквизит.Ключ] <> Реквизит.Значение Тогда
				Классификатор[Реквизит.Ключ] = Реквизит.Значение;
			КонецЕсли;
		КонецЦикла;
		
	Иначе	
		Классификатор = КлассификаторСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если Номенклатура.ЭтоНовый() Тогда
		Номенклатура.ЕдиницаИзмерения = Справочники.БазовыеЕдиницыИзмерения.НайтиПоКоду("796");
		Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	КонецЕсли;
	    	
	РеквизитыНоменклатуры = Новый Структура;
	РеквизитыНоменклатуры.Вставить("Код", Реквизиты.Код);
	РеквизитыНоменклатуры.Вставить("Наименование", Реквизиты.Наименование);
	РеквизитыНоменклатуры.Вставить("Родитель", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Родитель)));
	Если НЕ Реквизиты.ЭтоГруппа Тогда
		РеквизитыНоменклатуры.Вставить("ОбъемДАЛ", Реквизиты.Объем / 10);
		РеквизитыНоменклатуры.Вставить("Крепость", Реквизиты.Крепость);
		РеквизитыНоменклатуры.Вставить("АлкогольнаяПродукция", Реквизиты.АлкогольнаяПродукция);
		РеквизитыНоменклатуры.Вставить("СтавкаНДС",Перечисления.СтавкиНДС.НДС22);
		
		ЭтоТабачнаяПродукция 	= Ложь;
		ЭтоПиво 				= Ложь;
		ЭтоСоковаяПродукция 	= Ложь; 
		ЭтоБезалкогольноеПиво	= Ложь;
		
		Если ПолучитьФункциональнуюОпцию("ВестиУчетМаркируемойПродукцииИСМП") Тогда
	        ЭтоТабачнаяПродукция	=  Реквизиты.ТабачнаяПродукция; 
			ЭтоПиво 				=  Реквизиты.Пиво;  
			ЭтоСоковаяПродукция 	=  Реквизиты.СоковаяПродукция; 
			ЭтоБезалкогольноеПиво	=  Реквизиты.БезалкогольноеПиво;
    	КонецЕсли;	
		
		РеквизитыНоменклатуры.Вставить("КодЕГАИС", Реквизиты.КодЕГАИС);
		Если ЗначениеЗаполнено(Реквизиты.ВидПродукции) Тогда
			РеквизитыНоменклатуры.Вставить("ВидАлкогольнойПродукцииЕГАИС", Справочники.ВидыАлкогольнойПродукции.НайтиПоКоду(Реквизиты.ВидПродукции));
		КонецЕсли;
		РеквизитыНоменклатуры.Вставить("Вес", Реквизиты.Вес);
		РеквизитыНоменклатуры.Вставить("СтранаПроисхождения", ЗагрузитьСтрану(Реквизиты.Страна));
		
		Если РеквизитыНоменклатуры.АлкогольнаяПродукция И Не ЭтоПиво  =  Истина Тогда
			РеквизитыНоменклатуры.Вставить("ВидНоменклатуры", ?(Реквизиты.Импортная, ВидыНоменклатуры.Импортная, ВидыНоменклатуры.Российская));
			РеквизитыНоменклатуры.Вставить("ОсобенностьУчета", Перечисления.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукция);//09-04-19
		ИначеЕсли ЭтоТабачнаяПродукция  =  Истина Тогда	
			РеквизитыНоменклатуры.Вставить("ВидНоменклатуры", ВидыНоменклатуры.ТабачнаяПродукция);
			РеквизитыНоменклатуры.Вставить("ОсобенностьУчета", Перечисления.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция);//17-10-19 
		ИначеЕсли ЭтоПиво  =  Истина Тогда	
			РеквизитыНоменклатуры.Вставить("ВидНоменклатуры", ВидыНоменклатуры.Пиво);
			РеквизитыНоменклатуры.Вставить("ОсобенностьУчета", Перечисления.ОсобенностиУчетаНоменклатуры.Пиво);//04-06-24  
		ИначеЕсли ЭтоСоковаяПродукция  =  Истина Тогда		
			РеквизитыНоменклатуры.Вставить("ВидНоменклатуры", ВидыНоменклатуры.СоковаяПродукция);
			РеквизитыНоменклатуры.Вставить("ОсобенностьУчета", Перечисления.ОсобенностиУчетаНоменклатуры.СоковаяПродукция);  
		ИначеЕсли ЭтоБезалкогольноеПиво  =  Истина Тогда		
			РеквизитыНоменклатуры.Вставить("ВидНоменклатуры", ВидыНоменклатуры.БезалкогольноеПиво);
			РеквизитыНоменклатуры.Вставить("ОсобенностьУчета",Перечисления.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво);  
		Иначе
			РеквизитыНоменклатуры.Вставить("ВидНоменклатуры", ВидыНоменклатуры.Безалкогольная);
			РеквизитыНоменклатуры.Вставить("ОсобенностьУчета", Перечисления.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета);
		КонецЕсли;
							
		Если ЗначениеЗаполнено(Реквизиты.Производитель) Тогда
			РеквизитыНоменклатуры.Вставить("ПроизводительИмпортерАлкогольнойПродукции", Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Производитель)));
			Если Реквизиты.АлкогольнаяПродукция И  НЕ Реквизиты.Импортная Тогда
				РеквизитыНоменклатуры.Вставить("Производитель", РеквизитыНоменклатуры.ПроизводительИмпортерАлкогольнойПродукции); 
			КонецЕсли;
		КонецЕсли;
		РеквизитыНоменклатуры.Вставить("НаименованиеПолное", Реквизиты.Наименование);
		РеквизитыНоменклатуры.Вставить("Описание", Реквизиты.НаименованиеЕГАИС);
	КонецЕсли;
	
	Для Каждого Реквизит Из РеквизитыНоменклатуры Цикл
		РеквизитЗначение 		= Реквизит.Значение;
		НоменклатураРеквизит 	= Номенклатура[Реквизит.Ключ];
		
		Если Реквизит.Ключ = "Код" Тогда
			НоменклатураРеквизит = СокрЛП(НоменклатураРеквизит);
		КонецЕсли;	
		
		Если Реквизит.Ключ = "Наименование" Тогда
			РеквизитЗначение = Лев(Реквизит.Значение,100);
		КонецЕсли;	
		 		
		Если НоменклатураРеквизит <> РеквизитЗначение Тогда
			Номенклатура[Реквизит.Ключ] = РеквизитЗначение;
		КонецЕсли;
	КонецЦикла;
	
	ИзмененнаяНоменклатура = Неопределено;
	НачатьТранзакцию();
	Попытка
		Если Номенклатура.Модифицированность() Тогда
			Номенклатура.Записать();
			НоменклатураСсылка = Номенклатура.Ссылка;
			ИзмененнаяНоменклатура = НоменклатураСсылка;
		КонецЕсли;
		
		Если Классификатор.Модифицированность() Тогда
			Классификатор.Записать();
			КлассификаторСсылка = Классификатор.Ссылка;
		КонецЕсли;
		
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("АлкогольнаяПродукция", КлассификаторСсылка);
		Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(СоответствиеНоменклатурыЕГАИС.Порядок) КАК Порядок,
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|ГДЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура = &Номенклатура
		|	И СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция
		|
		|СГРУППИРОВАТЬ ПО
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура";
	
        Результат = Запрос.Выполнить();
		
		Если Результат.Пустой() Тогда
						
			Порядок = 0;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("АлкогольнаяПродукция", КлассификаторСсылка);
			Запрос.Текст =
			"ВЫБРАТЬ
			|	МАКСИМУМ(СоответствиеНоменклатурыЕГАИС.Порядок) КАК Порядок
			|ИЗ
			|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
			|ГДЕ
			|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция = &АлкогольнаяПродукция";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если ТипЗнч(Выборка.Порядок) = Тип("Число") Тогда
					Порядок = Выборка.Порядок;
				КонецЕсли;
			КонецЕсли;
			
			Запись = РегистрыСведений.СоответствиеНоменклатурыЕГАИС.СоздатьМенеджерЗаписи();
			Запись.Номенклатура         = НоменклатураСсылка;
			Запись.АлкогольнаяПродукция = КлассификаторСсылка;
			Запись.Порядок              = Порядок + 1;
			Запись.Записать();
			
		КонецЕсли;
		
		//EAN13
		ВсеШтрихкоды = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
		ВсеШтрихкоды.Отбор.Владелец.Установить(НоменклатураСсылка);
		ВсеШтрихкоды.Отбор.ТипШтрихкода.Установить(ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13);
		ВсеШтрихкоды.Прочитать();
		ВсеШтрихкоды.Очистить();
		Для Индекс = 1 По СтрЧислоСтрок(Реквизиты.Штрихкод) Цикл
			Штрихкод = СокрЛП(СтрПолучитьСтроку(Реквизиты.Штрихкод, Индекс));
			Если СтрДлина(Штрихкод) <> 13 Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйШтрихкод = ВсеШтрихкоды.Добавить();
			НовыйШтрихкод.Владелец = НоменклатураСсылка;
			НовыйШтрихкод.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			НовыйШтрихкод.Штрихкод = Штрихкод;
		КонецЦикла;
		Если ВсеШтрихкоды.Количество() = 0 Тогда
			НовыйШтрихкод = ВсеШтрихкоды.Добавить();
			НовыйШтрихкод.Владелец = НоменклатураСсылка;
			НовыйШтрихкод.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			НовыйШтрихкод.Штрихкод = "0000000000000";
		КонецЕсли;
		ВсеШтрихкоды.Записать();
		
		//EAN8
		ВсеШтрихкоды = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
		ВсеШтрихкоды.Отбор.Владелец.Установить(НоменклатураСсылка);
		ВсеШтрихкоды.Отбор.ТипШтрихкода.Установить(ПланыВидовХарактеристик.ТипыШтрихкодов.EAN8);
		ВсеШтрихкоды.Прочитать();
		ВсеШтрихкоды.Очистить();
		Для Индекс = 1 По СтрЧислоСтрок(Реквизиты.Штрихкод) Цикл
			Штрихкод = СокрЛП(СтрПолучитьСтроку(Реквизиты.Штрихкод, Индекс));
			Если СтрДлина(Штрихкод) <> 8  Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйШтрихкод = ВсеШтрихкоды.Добавить();
			НовыйШтрихкод.Владелец = НоменклатураСсылка;
			НовыйШтрихкод.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN8;
			НовыйШтрихкод.Штрихкод = Штрихкод;
		КонецЦикла;
		ВсеШтрихкоды.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка загрузки номенклатуры: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ИзмененнаяНоменклатура;
КонецФункции

Функция ПолучитьВидыНоменклатуры()
	
	ОбрабатыватьМаркируемуюПродукцию = ПолучитьФункциональнуюОпцию("ВестиУчетМаркируемойПродукцииИСМП");   

	Если ОбрабатыватьМаркируемуюПродукцию Тогда 
		
		Виды = Новый Структура("Безалкогольная, Импортная, Российская, ТабачнаяПродукция, Пиво,СоковаяПродукция,БезалкогольноеПиво");   
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВидыНоменклатуры.Ссылка КАК Ссылка,
		               |	ВидыНоменклатуры.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		               |	ВидыНоменклатуры.ИмпортнаяАлкогольнаяПродукция КАК Импортная,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК ТабачнаяПродукция,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК БезалкогольноеПиво,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.СоковаяПродукция)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК СоковаяПродукция,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.Пиво)
		               |				ИЛИ ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ПивоВПотребительскихУпаковках)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК Пиво
		               |ИЗ
		               |	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		               |ГДЕ
		               |	ВидыНоменклатуры.ВидАлкогольнойПродукцииЕГАИС = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
		               |	И НЕ ВидыНоменклатуры.ПометкаУдаления
		               |	И ВидыНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		               |	И ВидыНоменклатуры.Наименование В (""Товар"", ""Соковая продукция"", ""Безалкогольное пиво"", ""Пиво"", ""Алкоголь (Россия)"", ""Алкоголь (Импорт)"", ""Табачная продукция"")
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВидыНоменклатуры.Ссылка,
		               |	ВидыНоменклатуры.ИмпортнаяАлкогольнаяПродукция,
		               |	ВидыНоменклатуры.АлкогольнаяПродукция,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.Пиво)
		               |				ИЛИ ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ПивоВПотребительскихУпаковках)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ,
		               |	ВЫБОР
		               |		КОГДА ВидыНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.СоковаяПродукция)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ";
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если НЕ Выборка.АлкогольнаяПродукция И НЕ Выборка.ТабачнаяПродукция И  НЕ Выборка.СоковаяПродукция И НЕ Выборка.БезалкогольноеПиво Тогда
				Виды.Безалкогольная = Выборка.Ссылка;
			ИначеЕсли Выборка.АлкогольнаяПродукция И Выборка.Импортная И НЕ Выборка.Пиво  Тогда
				Виды.Импортная = Выборка.Ссылка;
			ИначеЕсли Выборка.АлкогольнаяПродукция И НЕ Выборка.Импортная И НЕ Выборка.Пиво Тогда
				Виды.Российская = Выборка.Ссылка;
			ИначеЕсли НЕ Выборка.АлкогольнаяПродукция И Выборка.ТабачнаяПродукция Тогда
				Виды.ТабачнаяПродукция = Выборка.Ссылка; 
			ИначеЕсли Выборка.АлкогольнаяПродукция И Выборка.Пиво Тогда
				Виды.Пиво = Выборка.Ссылка; 
			ИначеЕсли Выборка.СоковаяПродукция Тогда
				Виды.СоковаяПродукция = Выборка.Ссылка; 
			ИначеЕсли Выборка.БезалкогольноеПиво Тогда
				Виды.БезалкогольноеПиво = Выборка.Ссылка; 
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Элемент Из Виды Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйВид = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
			Если Элемент.Ключ = "Безалкогольная" Тогда
				НовыйВид.Наименование = "Товар";
				НовыйВид.АлкогольнаяПродукция = Ложь;
			ИначеЕсли Элемент.Ключ = "Импортная" Тогда
				НовыйВид.Наименование = "Алкоголь (Импорт)";
				НовыйВид.АлкогольнаяПродукция = Истина;
				НовыйВид.ИмпортнаяАлкогольнаяПродукция = Истина;
			ИначеЕсли Элемент.Ключ = "Российская" Тогда
				НовыйВид.Наименование = "Алкоголь (Россия)";
				НовыйВид.АлкогольнаяПродукция = Истина;
			ИначеЕсли Элемент.Ключ = "ТабачнаяПродукция" Тогда
				НовыйВид.Наименование = "Табачная продукция";
				НовыйВид.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.ТабачнаяПродукция;  
			ИначеЕсли Элемент.Ключ = "Пиво" Тогда
				НовыйВид.Наименование = "Пиво";
				НовыйВид.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.Пиво;
			ИначеЕсли Элемент.Ключ = "СоковаяПродукция" Тогда
				НовыйВид.Наименование = "Соковая продукция";
				НовыйВид.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.СоковаяПродукция;
			ИначеЕсли Элемент.Ключ = "БезалкогольноеПиво" Тогда
				НовыйВид.Наименование = "Безалкогольное пиво";
				НовыйВид.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры.БезалкогольноеПиво;
			КонецЕсли;     
			НовыйВид.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
			НовыйВид.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
			НовыйВид.Записать();
			Виды[Элемент.Ключ] = НовыйВид.Ссылка;
		КонецЦикла;
		
		Возврат Виды;
		
	Иначе
		
		Виды = Новый Структура("Безалкогольная, Импортная, Российская");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Ссылка,
		|	ВидыНоменклатуры.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
		|	ВидыНоменклатуры.ИмпортнаяАлкогольнаяПродукция КАК Импортная
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|ГДЕ
		|	ВидыНоменклатуры.ВидАлкогольнойПродукцииЕГАИС = ЗНАЧЕНИЕ(Справочник.ВидыАлкогольнойПродукции.ПустаяСсылка)
		|	И НЕ ВидыНоменклатуры.ПометкаУдаления
		|	И ВидыНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		|	И ВидыНоменклатуры.Наименование В (""Товар"", ""Алкоголь (Россия)"", ""Алкоголь (Импорт)"")
		|
		|СГРУППИРОВАТЬ ПО
		|	ВидыНоменклатуры.Ссылка,
		|	ВидыНоменклатуры.ИмпортнаяАлкогольнаяПродукция,
		|	ВидыНоменклатуры.АлкогольнаяПродукция";
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если НЕ Выборка.АлкогольнаяПродукция Тогда
				Виды.Безалкогольная = Выборка.Ссылка;
			ИначеЕсли Выборка.АлкогольнаяПродукция И Выборка.Импортная Тогда
				Виды.Импортная = Выборка.Ссылка;
			ИначеЕсли Выборка.АлкогольнаяПродукция И НЕ Выборка.Импортная Тогда
				Виды.Российская = Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Элемент Из Виды Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйВид = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
			Если Элемент.Ключ = "Безалкогольная" Тогда
				НовыйВид.Наименование = "Товар";
				НовыйВид.АлкогольнаяПродукция = Ложь;
			ИначеЕсли Элемент.Ключ = "Импортная" Тогда
				НовыйВид.Наименование = "Алкоголь (Импорт)";
				НовыйВид.АлкогольнаяПродукция = Истина;
				НовыйВид.ИмпортнаяАлкогольнаяПродукция = Истина;
			ИначеЕсли Элемент.Ключ = "Российская" Тогда
				НовыйВид.Наименование = "Алкоголь (Россия)";
				НовыйВид.АлкогольнаяПродукция = Истина;
			КонецЕсли;     
			НовыйВид.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
			НовыйВид.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
			НовыйВид.Записать();
			Виды[Элемент.Ключ] = НовыйВид.Ссылка;
		КонецЦикла;
		
		Возврат Виды;
		
	КонецЕсли;
	
КонецФункции

Функция СоздатьКлассификаторНоменклатуры(Реквизиты)
	КлассификаторСсылка = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(Реквизиты.КодЕГАИС);
	Если ЗначениеЗаполнено(КлассификаторСсылка) Тогда
		Классификатор = КлассификаторСсылка.ПолучитьОбъект();
	Иначе
		Классификатор = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.СоздатьЭлемент();
		Классификатор.Код = Реквизиты.КодЕГАИС;
	КонецЕсли;
	
	Если Реквизиты.НаименованиеЕГАИС <> Классификатор.Наименование Тогда
		Классификатор.Наименование = Реквизиты.НаименованиеЕГАИС;
		Классификатор.НаименованиеПолное = Реквизиты.НаименованиеЕГАИС;
	КонецЕсли;
	
	Если Реквизиты.Крепость <> Классификатор.Крепость Тогда
		Классификатор.Крепость = Реквизиты.Крепость;
	КонецЕсли;
	
	Возврат КлассификаторСсылка;
КонецФункции

Процедура ПрочитатьВидПродукции(ДанныеСправочника)
	ОбъектыДанных = Новый Массив;
	ОбъектыДанных.Добавить(Новый Структура("Справочник, Ссылка, Объект", "ВидыАлкогольнойПродукции"));
	
	Для Каждого Элемент Из ОбъектыДанных Цикл
		Элемент.Ссылка = Справочники[Элемент.Справочник].НайтиПоКоду(ДанныеСправочника.Код);
		Если ЗначениеЗаполнено(Элемент.Ссылка) Тогда
			Элемент.Объект = Элемент.Ссылка.ПолучитьОбъект();
		Иначе
			Элемент.Объект = Справочники[Элемент.Справочник].СоздатьЭлемент();
			Элемент.Объект.Код = ДанныеСправочника.Код;
		КонецЕсли;
	КонецЦикла;
	
	ЗагруженныеРеквизиты = Новый Структура("Наименование, ВидЛицензии, Маркируемый",
	ДанныеСправочника.Наименование, Перечисления.ВидыЛицензийАлкогольнойПродукции.ПустаяСсылка(), Ложь);     
	
	ДанныеСправочникаКод = Лев(ДанныеСправочника.Код,3);
	
	Если ДанныеСправочникаКод > "000" И ДанныеСправочникаКод < "200"
		ИЛИ ДанныеСправочникаКод = "300" ИЛИ ДанныеСправочникаКод = "310" ИЛИ ДанныеСправочникаКод = "340" Тогда
		ЗагруженныеРеквизиты.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.Спирт;
	ИначеЕсли ДанныеСправочникаКод >= "200" И ДанныеСправочникаКод <= "260"
		ИЛИ ДанныеСправочникаКод = "270" ИЛИ ДанныеСправочникаКод = "280"
		ИЛИ ДанныеСправочникаКод >= "400" И ДанныеСправочникаКод <= "462" Тогда
		ЗагруженныеРеквизиты.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.АлкогольнаяПродукция;
		ЗагруженныеРеквизиты.Маркируемый = Истина;
	ИначеЕсли ДанныеСправочникаКод >= "261" И ДанныеСправочникаКод <= "263"
		ИЛИ ДанныеСправочникаКод >= "500" И ДанныеСправочникаКод <= "520" Тогда
		ЗагруженныеРеквизиты.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.Пиво;
		ЗагруженныеРеквизиты.Маркируемый = Ложь;
	ИначеЕсли ДанныеСправочникаКод >= "320" И ДанныеСправочникаКод <> "340" И ДанныеСправочникаКод <= "350" Тогда
		ЗагруженныеРеквизиты.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяПищеваяПродукция;
	ИначеЕсли ДанныеСправочникаКод >= "481" И ДанныеСправочникаКод <= "485" Тогда
		ЗагруженныеРеквизиты.ВидЛицензии = Перечисления.ВидыЛицензийАлкогольнойПродукции.СпиртосодержащаяНепищеваяПродукция;
	КонецЕсли;
	
	Для Каждого Элемент Из ОбъектыДанных Цикл
		Если Элемент.Объект.Наименование <> ЗагруженныеРеквизиты.Наименование Тогда
			Элемент.Объект.Наименование = ЗагруженныеРеквизиты.Наименование;
		КонецЕсли;
		
		Если Элемент.Объект.ВидЛицензии <> ЗагруженныеРеквизиты.ВидЛицензии Тогда
			Элемент.Объект.ВидЛицензии = ЗагруженныеРеквизиты.ВидЛицензии;
		КонецЕсли;
		
		Если Элемент.Объект.Метаданные().Реквизиты.Найти("Маркируемый") <> Неопределено И Элемент.Объект.Маркируемый <> ЗагруженныеРеквизиты.Маркируемый Тогда
			Элемент.Объект.Маркируемый = ЗагруженныеРеквизиты.Маркируемый;
		КонецЕсли;
		
		Если Элемент.Объект.Модифицированность() Тогда
			Попытка
				Элемент.Объект.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи вида продукции: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПрочитатьГруппуНоменклатуры(Реквизиты)
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Идентификатор));
	Номенклатура = НоменклатураСсылка.ПолучитьОбъект();
	
	Если Номенклатура = Неопределено Тогда
		Номенклатура = Справочники.Номенклатура.СоздатьГруппу();
		Номенклатура.УстановитьСсылкуНового(НоменклатураСсылка);
	КонецЕсли;
	
	Если Номенклатура.Код <> Формат(Реквизиты.Код, "ЧГ=0") Тогда
		Номенклатура.Код = Формат(Реквизиты.Код, "ЧГ=0");
	КонецЕсли;
	
	Если Номенклатура.Наименование <> Реквизиты.Наименование Тогда
		Номенклатура.Наименование = Реквизиты.Наименование;
	КонецЕсли;
	
	Родитель = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Родитель));
	Если Номенклатура.Родитель <> Родитель Тогда
		Номенклатура.Родитель = Родитель;
	КонецЕсли;
	
	Если Номенклатура.Модифицированность() Тогда
		Попытка
			Номенклатура.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка записи номенклатуры: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Процедура ПрочитатьКонтрагентаЕГАИС(Реквизиты)
	КонтрагентЕГАИССсылка = Справочники.КлассификаторОрганизацийЕГАИС.НайтиПоКоду(Реквизиты.Код);
	Если ЗначениеЗаполнено(КонтрагентЕГАИССсылка) Тогда
		КонтрагентЕГАИС = КонтрагентЕГАИССсылка.ПолучитьОбъект();
	Иначе
		КонтрагентЕГАИС = Справочники.КлассификаторОрганизацийЕГАИС.СоздатьЭлемент();
		КонтрагентЕГАИС.Код = Реквизиты.Код;
	КонецЕсли;
	
	НовыеРеквизиты = Новый Структура();
	НовыеРеквизиты.Вставить("Наименование", Реквизиты.Наименование);
	НовыеРеквизиты.Вставить("НаименованиеПолное", Реквизиты.ПолнНаименование);
	НовыеРеквизиты.Вставить("КодСтраны", Число(Реквизиты.КодСтраны));
	НовыеРеквизиты.Вставить("ПредставлениеАдреса", Реквизиты.Адрес);
	
	Если Реквизиты.ТаможенныйСоюз Тогда
		НовыеРеквизиты.Вставить("ТипОрганизации", Перечисления.ТипыОрганизацийЕГАИС.КонтрагентТаможенногоСоюза);
		НовыеРеквизиты.Вставить("ИдентификаторОрганизацииТС", Реквизиты.ИНН);
		НовыеРеквизиты.Вставить("ИНН", "");
		НовыеРеквизиты.Вставить("КПП", "");
	ИначеЕсли Реквизиты.КодСтраны = "643" Тогда
		НовыеРеквизиты.Вставить("ТипОрганизации", Перечисления.ТипыОрганизацийЕГАИС.ЮридическоеЛицоРФ);
		НовыеРеквизиты.Вставить("ИНН", Реквизиты.ИНН);
		НовыеРеквизиты.Вставить("КПП", Реквизиты.КПП);
		Если ЗначениеЗаполнено(Реквизиты.КПП) Тогда
			Попытка
				НовыеРеквизиты.Вставить("КодРегиона", Число(Лев(СокрЛП(Реквизиты.КПП), 2)));
			Исключение
			КонецПопытки;
		КонецЕсли;
	Иначе
		НовыеРеквизиты.Вставить("ТипОрганизации", Перечисления.ТипыОрганизацийЕГАИС.ИностранныйКонтрагент);
	КонецЕсли;
	
	Для Каждого НовоеЗначение Из НовыеРеквизиты Цикл
		Если (ЗначениеЗаполнено(КонтрагентЕГАИС[НовоеЗначение.Ключ]) ИЛИ ЗначениеЗаполнено(НовоеЗначение.Значение))
			И КонтрагентЕГАИС[НовоеЗначение.Ключ] <> НовоеЗначение.Значение
			Тогда
			КонтрагентЕГАИС[НовоеЗначение.Ключ] = НовоеЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Если ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Контрагент));
		Если ЗначениеЗаполнено(Контрагент.ИНН) И Контрагент.ИНН <> КонтрагентЕГАИС.ИНН Тогда
			КонтрагентЕГАИС.ИНН = Контрагент.ИНН;
		КонецЕсли;
		Если ЗначениеЗаполнено(Контрагент.КПП) И Контрагент.КПП <> КонтрагентЕГАИС.КПП Тогда
			КонтрагентЕГАИС.КПП = Контрагент.КПП;
		КонецЕсли;
	КонецЕсли;
	
	Если КонтрагентЕГАИС.Модифицированность() Тогда
		Попытка
			КонтрагентЕГАИС.Записать();
			КонтрагентЕГАИССсылка = КонтрагентЕГАИС.Ссылка;
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи орг. ЕГАИС: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтрагентЕГАИССсылка) Тогда
		//СоответствиеКонтрагентов = РегистрыСведений.СоответствиеОрганизацийЕГАИС.Получить(Новый Структура("ОрганизацияЕГАИС", КонтрагентЕГАИССсылка));
		//Если СоответствиеКонтрагентов.Контрагент <> Контрагент Тогда
		//	СоответствиеКонтрагентов = РегистрыСведений.СоответствиеОрганизацийЕГАИС.СоздатьМенеджерЗаписи();
		//	СоответствиеКонтрагентов.ОрганизацияЕГАИС = КонтрагентЕГАИССсылка;
		//	СоответствиеКонтрагентов.Контрагент = Контрагент;
		//	Попытка
		//		СоответствиеКонтрагентов.Записать();
		//	Исключение
		//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка формирования соответствия орг. ЕГАИС: " + ОписаниеОшибки());
		//	КонецПопытки;
		//КонецЕсли;
		
		
		УстановитьПривилегированныйРежим(Истина);
		 		
		Спр = КонтрагентЕГАИССсылка.ПолучитьОбъект();
		Спр.СоответствуетОрганизации = ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации");
		Спр.Контрагент = Контрагент;
		Спр.ТорговыйОбъект = ?(Спр.СоответствуетОрганизации, ПараметрыСеанса.ТекущийМагазин, Неопределено);
	
		Спр.Записать();
 		
		
		
	КонецЕсли;
КонецПроцедуры

Процедура ПрочитатьКонтрагента(Реквизиты)
	КонтрагентСсылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Реквизиты.Идентификатор));
	Контрагент = КонтрагентСсылка.ПолучитьОбъект();
	
	Если Контрагент = Неопределено Тогда
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		Контрагент.УстановитьСсылкуНового(КонтрагентСсылка);
	КонецЕсли;
	
	Родитель = Справочники.Контрагенты.НайтиПоНаименованию("Производители");
	Если НЕ ЗначениеЗаполнено(Родитель) Тогда
		Группа = Справочники.Контрагенты.СоздатьГруппу();
		Группа.Наименование = "Производители";
		Группа.Записать();
		Родитель = Группа.Ссылка;
	КонецЕсли;
	Контрагент.Родитель = Родитель;
	
	СоответствияРеквизитов = Новый Соответствие;
	СоответствияРеквизитов.Вставить("Наименование", "Наименование");
	СоответствияРеквизитов.Вставить("ИНН", "ИНН");
	СоответствияРеквизитов.Вставить("КПП", "КПП");
	СоответствияРеквизитов.Вставить("КодПоОКПО", "ОКПО");
	СоответствияРеквизитов.Вставить("НаименованиеПолное", "ПолноеНаименование");
	
	Для Каждого Элемент Из СоответствияРеквизитов Цикл
		Если (ЗначениеЗаполнено(Контрагент[Элемент.Ключ]) ИЛИ ЗначениеЗаполнено(Реквизиты[Элемент.Значение])) И Контрагент[Элемент.Ключ] <> Реквизиты[Элемент.Значение] Тогда
			Контрагент[Элемент.Ключ] = Реквизиты[Элемент.Значение];
		КонецЕсли;
	КонецЦикла;
	
	Контрагент.ЮрФизЛицо = ?(Реквизиты.ЮрФизЛицо = "физ", Перечисления.ЮрФизЛицо.ФизЛицо, Перечисления.ЮрФизЛицо.ЮрЛицо);
	
	Если Контрагент.Модифицированность() Тогда
		Попытка
			Контрагент.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при записи контрагента: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработкаДанныхПередОбменом

Процедура ЗаполнитьКассовуюКнигу(пОбъект)
	
	пОбъект.КассовыеОрдера.Очистить();
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КассоваяКнига.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КассоваяКнига КАК КассоваяКнига
	|ГДЕ
	|	КассоваяКнига.Ссылка <> &ТекущийДокумент
	|	И КассоваяКнига.Организация = &Организация
	|	И КассоваяКнига.Магазин = &Магазин
	|	И КассоваяКнига.Проведен
	|	И НачалоПериода(КассоваяКнига.Дата, ДЕНЬ) = &ДатаНач
	|");
	
	Запрос.УстановитьПараметр("ТекущийДокумент", пОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", пОбъект.Организация);
	Запрос.УстановитьПараметр("Магазин", пОбъект.Магазин);
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(пОбъект.Дата));
	
	ЗаполнятьДокументы = Истина;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнятьДокументы = Ложь;
	КонецЦикла;

	Если ЗаполнятьДокументы Тогда
		
		Запрос = Новый Запрос;
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Кассы.Ссылка КАК Касса
		|ПОМЕСТИТЬ КассыМагазина
		|ИЗ
		|	Справочник.Кассы КАК Кассы
		|ГДЕ
		|	Кассы.Владелец = &Организация
		|	%УсловиеМагазин%
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДенежныеСредства.Регистратор КАК КассовыйОрдер,
		|	СУММА(ВЫБОР
		|			КОГДА ДенежныеСредства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА ДенежныеСредства.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Приход,
		|	СУММА(ВЫБОР
		|			КОГДА ДенежныеСредства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ДенежныеСредства.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Расход,
		|	МАКСИМУМ(СтатьиДДС.КорреспондирующийСчет) КАК КорреспондирующийСчет
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваНаличные КАК ДенежныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КассоваяКнига.КассовыеОрдера КАК КассоваяКнига
		|		ПО (КассоваяКнига.Ссылка <> &Ссылка)
		|			И (КассоваяКнига.Ссылка.Проведен)
		|			И (КассоваяКнига.КассовыйОрдер = ДенежныеСредства.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДДС
		|		ПО (СтатьиДДС.Ссылка = ДенежныеСредства.СтатьяДвиженияДенежныхСредств)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КассыМагазина КАК КассыМагазина
		|		ПО ДенежныеСредства.Касса = КассыМагазина.Касса
		|ГДЕ
		|	ДенежныеСредства.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ДенежныеСредства.Организация = &Организация
		|	%УсловиеМагазин1%
		|	%УсловиеХозОпераций%
		|
		|СГРУППИРОВАТЬ ПО
		|	ДенежныеСредства.Регистратор,
		|	ДенежныеСредства.Период
		|УПОРЯДОЧИТЬ ПО
		|	ДенежныеСредства.Период";
		
		Если ЗначениеЗаполнено(пОбъект.Магазин) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УсловиеМагазин%", "И Кассы.Магазин = &Магазин");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УсловиеМагазин1%", "И ДенежныеСредства.Касса.Магазин = &Магазин");
			
			УсловиеХозОпераций ="
			|	И ВЫБОР
			|			КОГДА ДенежныеСредства.СтатьяДвиженияДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствВДругуюКассу)
			|				ТОГДА ВЫБОР
			|						КОГДА ДенежныеСредства.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
			|							ТОГДА НЕ ДенежныеСредства.Регистратор.ДокументОснование.Касса.Магазин = ДенежныеСредства.Касса.Магазин
			|						ИНАЧЕ НЕ ДенежныеСредства.Касса.Магазин = ДенежныеСредства.Регистратор.КассаПолучатель.Магазин
			|					КОНЕЦ
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УсловиеХозОпераций%", УсловиеХозОпераций);
			
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УсловиеМагазин%", "");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УсловиеМагазин1%", "");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УсловиеХозОпераций%", 
			"И НЕ ДенежныеСредства.СтатьяДвиженияДенежныхСредств.ХозяйственнаяОперация В
			|(ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеДенежныхСредствИзДругойКассы),
			| ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствВДругуюКассу))");
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(пОбъект.Дата));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(пОбъект.Дата));
		Запрос.УстановитьПараметр("Организация", пОбъект.Организация);
		Запрос.УстановитьПараметр("Ссылка", пОбъект.Ссылка);
		Запрос.УстановитьПараметр("Магазин", пОбъект.Магазин);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			пОбъект.КассовыеОрдера.Загрузить(РезультатЗапроса.Выгрузить());
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьКассовыеДокументы()
	
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Истина;
	
	РегистрыНакопления.ДенежныеСредстваККМ.ПересчитатьИтоги();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДенежныеСредстваКПоступлениюНаличныеОстатки.ДокументПередачи КАК Выемка,
	               |	ДенежныеСредстваКПоступлениюНаличныеОстатки.ДокументПередачи.ОтчетОРозничныхПродажах КАК СсылкаНаОтчет,
	               |	ДенежныеСредстваКПоступлениюНаличныеОстатки.ДокументПередачи.ОтчетОРозничныхПродажах.Дата КАК СсылкаНаОтчетДата,
	               |	ДенежныеСредстваКПоступлениюНаличныеОстатки.ДокументПередачи.Дата КАК Дата,
	               |	ВложенныйЗапрос.Касса КАК Касса
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(Кассы.Ссылка) КАК Касса,
	               |		Кассы.Магазин КАК Магазин,
	               |		Кассы.Владелец КАК Организация
	               |	ИЗ
	               |		Справочник.Кассы КАК Кассы
	               |	ГДЕ
	               |		НЕ Кассы.ПометкаУдаления
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Кассы.Магазин,
	               |		Кассы.Владелец) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваКПоступлениюНаличные.Остатки(, ДокументПередачи ССЫЛКА Документ.ВыемкаДенежныхСредствИзКассыККМ) КАК ДенежныеСредстваКПоступлениюНаличныеОстатки
	               |		ПО (ДенежныеСредстваКПоступлениюНаличныеОстатки.ДокументПередачи.Магазин = ВложенныйЗапрос.Магазин)
	               |			И (ДенежныеСредстваКПоступлениюНаличныеОстатки.Организация = ВложенныйЗапрос.Организация)
	               |ГДЕ
	               |	ДенежныеСредстваКПоступлениюНаличныеОстатки.СуммаОстаток > 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СписокСозданныхДокументов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		 		
		Выемка = Выборка.Выемка;
			
		//Перенос выемки на дату отчета о розничных продажах. 
		
		Если ЗначениеЗаполнено(Выборка.СсылкаНаОтчет) Тогда
			Если НЕ НачалоДня(Выборка.Дата) = НачалоДня(Выборка.СсылкаНаОтчетДата) Тогда
				обВыемка = Выемка.ПолучитьОбъект();
				обВыемка.Дата = Выборка.СсылкаНаОтчетДата+1;
				Попытка 
					обВыемка.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение	
				КонецПопытки;	
			КонецЕсли;
		КонецЕсли;
		
		ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
		ПКО.Дата  = Выемка.Дата;
		ПКО.Касса = Выборка.Касса;
		ПКО.ДокументОснование = Выборка.Выемка;
		ПКО.Заполнить(Выборка.Выемка);
		ПКО.Основание = "Выручка за " + Формат(Выборка.Дата, "ДФ=dd/MM/yy");
		ПКО.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		ПКО.Комментарий = "Создан автоматически";
		Попытка
			ПКО.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			СписокСозданныхДокументов.Добавить(ПКО.Ссылка);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВложенныйЗапрос.КассовыйОрдер,
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.КассаМагазин КАК Магазин,
	|	ВложенныйЗапрос.День КАК День,
	|	ВложенныйЗапрос.Приход,
	|	ВложенныйЗапрос.Расход
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПриходныйКассовыйОрдер.Ссылка КАК КассовыйОрдер,
	|		ПриходныйКассовыйОрдер.Организация КАК Организация,
	|		ПриходныйКассовыйОрдер.Касса.Магазин КАК КассаМагазин,
	|		НАЧАЛОПЕРИОДА(ПриходныйКассовыйОрдер.Дата, ДЕНЬ) КАК День,
	|		ПриходныйКассовыйОрдер.СуммаДокумента КАК Приход,
	|		0 КАК Расход
	|	ИЗ
	|		Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|	ГДЕ
	|		ПриходныйКассовыйОрдер.Проведен
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РасходныйКассовыйОрдер.Ссылка,
	|		РасходныйКассовыйОрдер.Организация,
	|		РасходныйКассовыйОрдер.Касса.Магазин,
	|		НАЧАЛОПЕРИОДА(РасходныйКассовыйОрдер.Дата, ДЕНЬ),
	|		0,
	|		РасходныйКассовыйОрдер.СуммаДокумента
	|	ИЗ
	|		Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|	ГДЕ
	|		РасходныйКассовыйОрдер.Проведен) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КассоваяКнигаКассовыеОрдера.КассовыйОрдер КАК КассовыйОрдер,
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Дата КАК Дата,
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Организация КАК Организация,
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Магазин КАК Магазин
	|		ИЗ
	|			Документ.КассоваяКнига.КассовыеОрдера КАК КассоваяКнигаКассовыеОрдера
	|		ГДЕ
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Проведен
	|		
	|		СГРУППИРОВАТЬ ПО
	|			КассоваяКнигаКассовыеОрдера.КассовыйОрдер,
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Дата,
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Организация,
	|			КассоваяКнигаКассовыеОрдера.Ссылка.Магазин) КАК ДанныеКассовойКниги
	|		ПО ВложенныйЗапрос.КассовыйОрдер = ДанныеКассовойКниги.КассовыйОрдер
	|ГДЕ
	|	ДанныеКассовойКниги.Дата ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ЛистыПоДням = Новый ТаблицаЗначений;
	ЛистыПоДням.Колонки.Добавить("КассоваяКнига");
	ЛистыПоДням.Колонки.Добавить("День");
	ЛистыПоДням.Колонки.Добавить("Организация");
	ЛистыПоДням.Колонки.Добавить("Магазин");
	ОтборЛиста = Новый Структура("День, Организация, Магазин");
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОтборЛиста, Выборка);
		Лист = ЛистыПоДням.НайтиСтроки(ОтборЛиста);
		Если Лист.Количество() = 0 Тогда
			ЛистыСсылки = Документы.КассоваяКнига.Выбрать(Выборка.День, КонецДня(Выборка.День));
			ДокЛист = Неопределено;
			Пока ЛистыСсылки.Следующий() Цикл
				Если ЛистыСсылки.Проведен И ЛистыСсылки.Организация = Выборка.Организация И ЛистыСсылки.Магазин = Выборка.Магазин Тогда
					ДокЛист = ЛистыСсылки.ПолучитьОбъект();
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ДокЛист = Неопределено Тогда
				ДокЛист = Документы.КассоваяКнига.СоздатьДокумент();
				ДокЛист.Организация = Выборка.Организация;
				ДокЛист.Магазин = Выборка.Магазин;
				ДокЛист.ТипЛиста = Перечисления.ТипыЛистовКассовойКниги.Обычный;
				ДокЛист.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				ДокЛист.Дата = Выборка.День;
				ДокЛист.Комментарий = "Создан автоматически";
			КонецЕсли;
			
			НоваяСтрока = ЛистыПоДням.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Организация, Магазин");
			НоваяСтрока.День = Выборка.День;
			НоваяСтрока.КассоваяКнига = ДокЛист;
		Иначе
			ДокЛист = Лист[0].КассоваяКнига;
		КонецЕсли;
		
		СтрОрдер = ДокЛист.КассовыеОрдера.Найти(Выборка.КассовыйОрдер, "КассовыйОрдер");
		Если СтрОрдер = Неопределено Тогда
			ЗаполнитьКассовуюКнигу(ДокЛист);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из ЛистыПоДням Цикл
		Если Строка.КассоваяКнига.Модифицированность() Тогда
			Попытка
				Строка.КассоваяКнига.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
				Строка.КассоваяКнига.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				СписокСозданныхДокументов.Добавить(Строка.КассоваяКнига.Ссылка);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Ложь;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаДанных

Функция ЗагрузитьСтрану(КодСтраны)
	Страна = Справочники.СтраныМира.НайтиПоКоду(КодСтраны);
	Если ЗначениеЗаполнено(Страна) Тогда
		Возврат Страна;
	КонецЕсли;
	
	ДанныеСтраны = Справочники.СтраныМира.ДанныеКлассификатораСтранМираПоКоду(КодСтраны);
	Если ДанныеСтраны <> Неопределено Тогда
		НоваяСтрана = Справочники.СтраныМира.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НоваяСтрана, ДанныеСтраны);
		НоваяСтрана.Записать();
		Возврат НоваяСтрана.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СтраныМира.ПустаяСсылка();
КонецФункции

Процедура ЗагрузитьДанныеДокументов(Узел, ТаблицаРезультат)
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Строка Из ТаблицаРезультат Цикл
		СсылкаНаДокумент = Документы[СтрЗаменить(Строка.ТипИсточник, "Документ.", "")].ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.СсылкаИсточник));
		Если Строка.Успех ИЛИ ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") И Найти(Строка.ОписаниеОшибки, "период запрета") > 0 Тогда
			Если ЗначениеЗаполнено(Строка.СсылкаПриемник) Тогда
				Набор = РегистрыСведений.СоответствияОбъектовИнформационныхБаз.СоздатьНаборЗаписей();
				Набор.Отбор.УзелИнформационнойБазы.Установить(Узел);
				Набор.Отбор.УникальныйИдентификаторИсточника.Установить(СсылкаНаДокумент);
				Набор.Прочитать();
				Набор.Очистить();
				
				Запись = Набор.Добавить();
				Запись.ТипИсточника = Строка.ТипИсточник;
				Запись.УзелИнформационнойБазы = Узел;
				Запись.УникальныйИдентификаторИсточника = СсылкаНаДокумент;
				Запись.ТипПриемника = Строка.ТипПриемник;
				Запись.УникальныйИдентификаторПриемника = Строка.СсылкаПриемник;
				Запись.УникальныйИдентификаторИсточникаСтрокой = Строка.СсылкаИсточник;
				Запись.ОбъектВыгруженПоСсылке = Истина;
				Набор.Записать();
			КонецЕсли;
			
			Набор = РегистрыСведений.РезультатыОбменаДанными.СоздатьНаборЗаписей();
			Набор.Отбор.ПроблемныйОбъект.Установить(СсылкаНаДокумент);
			Набор.Прочитать();
			Набор.Очистить();
			Набор.Записать();
		Иначе
			Запись = РегистрыСведений.РезультатыОбменаДанными.СоздатьМенеджерЗаписи();
			Запись.ДатаВозникновения = ТекущаяДата();
			Запись.ПроблемныйОбъект = СсылкаНаДокумент;
			Запись.ТипПроблемы = Перечисления.ТипыПроблемОбменаДанными.НепроведенныйДокумент;
			Запись.УзелИнформационнойБазы = Узел;
			Запись.Причина = Строка.ОписаниеОшибки;
			Запись.Записать();
			
			Если Узел.Метаданные().Состав.Содержит(СсылкаНаДокумент.Метаданные()) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, СсылкаНаДокумент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура ЗагрузитьНоменклатуру(ПолученныеДанные) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ПолученныеДанные.Свойство("ВидыПродукции") Тогда
		Для Каждого Строка Из ПолученныеДанные.ВидыПродукции Цикл
			ПрочитатьВидПродукции(Строка);
		КонецЦикла;
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("Контрагенты") Тогда
		Для Каждого Строка Из ПолученныеДанные.Контрагенты Цикл
			ПрочитатьКонтрагента(Строка);
		КонецЦикла;
	КонецЕсли;
	
	Если ПолученныеДанные.Свойство("КонтрагентЕГАИС") Тогда
		Для Каждого Строка Из ПолученныеДанные.КонтрагентЕГАИС Цикл
			ПрочитатьКонтрагентаЕГАИС(Строка);
		КонецЦикла;
	КонецЕсли;
	
	ИзмененныйАлкоголь = Новый Массив;
	Если ПолученныеДанные.Свойство("Номенклатура") Тогда
		Для Каждого Строка Из ПолученныеДанные.Номенклатура Цикл
			Если Строка.ЭтоГруппа Тогда
				ПрочитатьГруппуНоменклатуры(Строка);
			Иначе
				НоваяНоменклатура = ПрочитатьНоменклатуру(Строка, ПолучитьВидыНоменклатуры());
				Если ЗначениеЗаполнено(НоваяНоменклатура) И НоваяНоменклатура.АлкогольнаяПродукция Тогда
					ИзмененныйАлкоголь.Добавить(НоваяНоменклатура);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Сегмент = Справочники.СегментыНоменклатуры.НайтиПоНаименованию("Алкогольная продукция");
	Если ЗначениеЗаполнено(Сегмент) Тогда
		Для Каждого Алкоголь Из ИзмененныйАлкоголь Цикл
			Если ЗначениеЗаполнено(Алкоголь) Тогда
				Запись = РегистрыСведений.НоменклатураСегмента.СоздатьМенеджерЗаписи();
				Запись.Сегмент = Сегмент;
				Запись.Номенклатура = Алкоголь;
				Запись.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры

Процедура ЗагрузитьПоставки(ТаблицаПоставок)     
	
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Истина;
	       	
	НовыеПоступления.Очистить();
	ЕстьАлкоголь = Ложь;
	
	Для Каждого СтрДокумент Из ТаблицаПоставок Цикл
		СтрРезультат = НовыеПоступления.Добавить();
		ЗаполнитьЗначенияСвойств(СтрРезультат, СтрДокумент);
		СтрРезультат.Загружено = Ложь;
		ЕстьАлкоголь = ЕстьАлкоголь ИЛИ СтрДокумент.ЕстьАлкоголь;
		
		Если НЕ ЗначениеЗаполнено(СтрДокумент.ДатаТТН) Тогда
			СтрРезультат[0].Сообщение = "Не заполнена дата ТТН";
			СтрРезультат[0].ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрДокумент.НомерТТН) Тогда
			СтрРезультат[0].Сообщение = "Не заполнен номер ТТН";
			СтрРезультат[0].ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	  	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.НомерТТН КАК НомерТТН,
	               |	Таб.ДатаТТН КАК ДатаТТН,
	               |	Таб.ПоставщикИНН КАК ПоставщикИНН,
	               |	Таб.ПоставщикКПП КАК ПоставщикКПП,
	               |	Таб.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ КПоступлению
	               |ИЗ
	               |	&Таб КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КПоступлению.НомерТТН КАК НомерТТН,
	               |	КПоступлению.ДатаТТН КАК ДатаТТН,
	               |	КПоступлению.НомерСтроки КАК НомерСтроки,
	               |	ТТНВходящаяЕГАИС.Ссылка КАК Ссылка,
	               |	ТТНВходящаяЕГАИС.ИдентификаторЕГАИС КАК ИдентификаторЕГАИС
	               |ПОМЕСТИТЬ ТТНЕГАИС
	               |ИЗ
	               |	КПоступлению КАК КПоступлению
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТТНВходящаяЕГАИС КАК ТТНВходящаяЕГАИС
	               |		ПО КПоступлению.НомерТТН = ТТНВходящаяЕГАИС.НомерТТН
	               |			И (НАЧАЛОПЕРИОДА(КПоступлению.ДатаТТН, ГОД) = НАЧАЛОПЕРИОДА(ТТНВходящаяЕГАИС.ДатаТТН, ГОД)
	               |				ИЛИ НАЧАЛОПЕРИОДА(КПоступлению.ДатаТТН, ГОД) = НАЧАЛОПЕРИОДА(ТТНВходящаяЕГАИС.ДатаОтгрузки, ГОД))
	               |			И КПоступлению.ПоставщикКПП = ТТНВходящаяЕГАИС.Грузоотправитель.КПП
	               |			И КПоступлению.ПоставщикКПП = ТТНВходящаяЕГАИС.Грузоотправитель.КПП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТТНЕГАИС.НомерСтроки КАК НомерСтроки,
	               |	ТТНЕГАИС.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ПоследняяТТНЕГАИС
	               |ИЗ
	               |	ТТНЕГАИС КАК ТТНЕГАИС
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ТТНЕГАИС.НомерСтроки КАК НомерСтроки,
	               |			МАКСИМУМ(ТТНЕГАИС.ИдентификаторЕГАИС) КАК ИдентификаторЕГАИС
	               |		ИЗ
	               |			ТТНЕГАИС КАК ТТНЕГАИС
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ТТНЕГАИС.НомерСтроки) КАК ВложенныйЗапрос
	               |		ПО ТТНЕГАИС.НомерСтроки = ВложенныйЗапрос.НомерСтроки
	               |			И ТТНЕГАИС.ИдентификаторЕГАИС = ВложенныйЗапрос.ИдентификаторЕГАИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КПоступлению.НомерТТН КАК НомерТТН,
	               |	КПоступлению.ДатаТТН КАК ДатаТТН,
	               |	КПоступлению.НомерСтроки КАК НомерСтроки,
	               |	КПоступлению.ПоставщикИНН КАК ПоставщикИНН,
	               |	КПоступлению.ПоставщикКПП КАК ПоставщикКПП,
	               |	ЕСТЬNULL(Контрагенты.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	               |	ЕСТЬNULL(ПоследняяТТНЕГАИС.Ссылка, ЗНАЧЕНИЕ(Документ.ТТНВходящаяЕГАИС.ПустаяСсылка)) КАК ТТНВходящая
	               |ИЗ
	               |	КПоступлению КАК КПоступлению
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПоследняяТТНЕГАИС КАК ПоследняяТТНЕГАИС
	               |		ПО КПоступлению.НомерСтроки = ПоследняяТТНЕГАИС.НомерСтроки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КПоступлению.НомерСтроки КАК НомерСтроки,
	               |			МАКСИМУМ(Контрагенты.Ссылка) КАК Контрагент
	               |		ИЗ
	               |			КПоступлению КАК КПоступлению
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |				ПО КПоступлению.ПоставщикИНН = Контрагенты.ИНН
	               |					И КПоступлению.ПоставщикКПП = Контрагенты.КПП
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КПоступлению.НомерСтроки) КАК Контрагенты
	               |		ПО КПоступлению.НомерСтроки = Контрагенты.НомерСтроки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КПоступлению.НомерСтроки КАК НомерСтроки,
	               |	ПоступлениеТоваров.Ссылка КАК Поступление,
	               |	ПоступлениеТоваров.Проведен КАК Проведен,
	               |	ПоступлениеТоваров.Дата КАК Дата
	               |ИЗ
	               |	КПоступлению КАК КПоступлению
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ПО КПоступлению.НомерТТН = ПоступлениеТоваров.НомерВходящегоДокумента
	               |			И (НАЧАЛОПЕРИОДА(КПоступлению.ДатаТТН, ГОД) = НАЧАЛОПЕРИОДА(ПоступлениеТоваров.ДатаВходящегоДокумента, ГОД))
	               |			И КПоступлению.ПоставщикИНН = ПоступлениеТоваров.Контрагент.ИНН";
	
	Запрос.УстановитьПараметр("Таб", НовыеПоступления.Выгрузить(Новый Структура("ЕстьОшибки", Ложь)));
	Результаты = Запрос.ВыполнитьПакет();
	ТабПоступления = Результаты[4].Выгрузить();
	СтрПоставки = Результаты[3].Выбрать();
	
	Отбор = Новый Структура("НомерТТН, ДатаТТН, ПоставщикИНН, ПоставщикКПП");
	Пока СтрПоставки.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрПоставки);
		СтрДокумент = ТаблицаПоставок.НайтиСтроки(Отбор);
		Если СтрДокумент.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДанныеДокумента = СтрДокумент[0];
		
		Если НЕ ЗначениеЗаполнено(СтрПоставки.Контрагент) Тогда
			НовыеПоступления[СтрПоставки.НомерСтроки - 1].Загружено = Ложь;
			НовыеПоступления[СтрПоставки.НомерСтроки - 1].Сообщение = "Не найден поставщик ИНН " + СтрДокумент.ПоставщикИНН + ", КПП " + СтрДокумент.ПоставщикКПП;
			Продолжить;
		КонецЕсли;
			
		Если ДанныеДокумента.ЕстьАлкоголь И НЕ ЗначениеЗаполнено(СтрПоставки.ТТНВходящая) Тогда
			НовыеПоступления[СтрПоставки.НомерСтроки - 1].Загружено = Ложь;
			НовыеПоступления[СтрПоставки.НомерСтроки - 1].Сообщение = "Отсутствует ТТН входящая ЕГАИС";
			Продолжить;
		КонецЕсли;
		
		ТаблицаТоваров = Новый ТаблицаЗначений;
		ТаблицаТоваров.Колонки.Добавить("НоменклатураКод", Новый ОписаниеТипов("Строка"));
		ТаблицаТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаТоваров.Колонки.Добавить("АлкогольнаяПродукция", Новый ОписаниеТипов("СправочникСсылка.КлассификаторАлкогольнойПродукцииЕГАИС"));
		ТаблицаТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		ТаблицаТоваров.Колонки.Добавить("Подобрано", Новый ОписаниеТипов("Булево"));
		ТаблицаТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
		ТаблицаТоваров.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		ТаблицаТоваров.Колонки.Добавить("Алкоголь", Новый ОписаниеТипов("Булево"));
		ТаблицаТоваров.Колонки.Добавить("ИдСправкиА", Новый ОписаниеТипов("Строка"));
		ТаблицаТоваров.Колонки.Добавить("ИдСправкиБ", Новый ОписаниеТипов("Строка"));
		
		Для Каждого СтрТовара Из ДанныеДокумента.ТабТовары Цикл
			НоваяСтрока = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТовара, "НоменклатураКод, Цена, Количество, Сумма, Алкоголь, ИдСправкиА, ИдСправкиБ");
			Если ЗначениеЗаполнено(СтрТовара.НоменклатураКодЕГАИС) Тогда
				 НоваяСтрока.АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(СтрТовара.НоменклатураКодЕГАИС);
			КонецЕсли;
			НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрТовара.Номенклатура));
		КонецЦикла;
		
		СуществующиеПоступления = ТабПоступления.Скопировать(Новый Структура("НомерСтроки", СтрПоставки.НомерСтроки));
		СуществующиеПоступления.Сортировать("Проведен Убыв, Дата Убыв");
		Если СуществующиеПоступления.Количество() > 0 Тогда
			ДокПоступление = СуществующиеПоступления[0].Поступление.ПолучитьОбъект();
			Если НЕ ДокПоступление.Проведен Тогда
				ДокПоступление.Дата = ТекущаяДата();
			КонецЕсли;
			ДокПоступление.Товары.Очистить();
			ДокПоступление.ТоварыПоДаннымПоставщика.Очистить();
			ДокПоступление.ЭтапыОплат.Очистить();
		Иначе
			ДокПоступление = Документы.ПоступлениеТоваров.СоздатьДокумент();
			//ДокПоступление.Дата = ТекущаяДата();
			ДокПоступление.Дата = НачалоДня(СтрПоставки.ДатаТТН) + 3600;
			ДокПоступление.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;		
		
		ДокПоступление.Магазин = ПараметрыСеанса.ТекущийМагазин;
		ДокПоступление.Склад = ДокПоступление.Магазин.СкладПоступления;
		ДокПоступление.Организация = ДокПоступление.Склад.Организация;
		ДокПоступление.УчитыватьНДС = Истина;
		ДокПоступление.ЦенаВключаетНДС = Истина;
		ДокПоступление.НомерВходящегоДокумента = СтрПоставки.НомерТТН;
		ДокПоступление.ДатаВходящегоДокумента = СтрПоставки.ДатаТТН;
		ДокПоступление.Контрагент = СтрПоставки.Контрагент;
		Если ДанныеДокумента.ЕстьАлкоголь Тогда
			ДокПоступление.ТТНВходящаяЕГАИС = СтрПоставки.ТТНВходящая;
		КонецЕсли;
		
		Если ЕстьАлкоголь Тогда
			Для Каждого СтрЕГАИС Из ДокПоступление.ТТНВходящаяЕГАИС.Товары Цикл
				СтрТовары = ДокПоступление.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(СтрТовары, СтрЕГАИС, "АлкогольнаяПродукция, Цена, Сумма, ИдентификаторСтроки, ИдентификаторУпаковки");
				СтрПоставщик = ДокПоступление.ТоварыПоДаннымПоставщика.Добавить();
				ЗаполнитьЗначенияСвойств(СтрПоставщик, СтрТовары);
				СтрПоставщик.Количество = СтрЕГАИС.Количество;
				СтрПоставщик.КоличествоУпаковок = СтрПоставщик.Количество;
				
				СтрПодходящие = ТаблицаТоваров.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, ИдСправкиА, ИдСправкиБ, Подобрано", СтрЕГАИС.АлкогольнаяПродукция, СтрЕГАИС.Справка2.НомерСправки1, СтрЕГАИС.НомерСправки2Поставщика, Ложь));
				Если СтрПодходящие.Количество() > 0 Тогда
					СтрПодходящие[0].Подобрано = Истина;
					ЗаполнитьЗначенияСвойств(СтрТовары, СтрПодходящие[0], "Номенклатура, Количество, Цена, Сумма");
					СтрТовары.КоличествоУпаковок = СтрПодходящие[0].Количество;
					СтрПоставщик.Номенклатура = СтрТовары.Номенклатура;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого СтрТовара Из ТаблицаТоваров Цикл
			Если СтрТовара.Подобрано Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрТовара.Алкоголь Тогда
				//Повторное заполнение - если по каким-то причинам раньше не был найден товар по справкам А, Б
				СтрЕГАИС = ДокПоступление.Товары.НайтиСтроки(Новый Структура("АлкогольнаяПродукция, Количество", СтрТовара.АлкогольнаяПродукция, 0));
				Если СтрЕГАИС.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(СтрЕГАИС[0], СтрТовара, "Номенклатура, Количество, Цена, Сумма");
					СтрЕГАИС[0].КоличествоУпаковок = СтрЕГАИС[0].Количество;
					СтрТовара.Подобрано = Истина;
					СтрПоставщика = ДокПоступление.ТоварыПоДаннымПоставщика.Найти(СтрЕГАИС[0].ИдентификаторСтроки, "ИдентификаторСтроки");
					Если СтрПоставщика <> Неопределено Тогда
						СтрПоставщика.Номенклатура = СтрТовара.Номенклатура;
					КонецЕсли;
				КонецЕсли;
			Иначе //Добавление безалкогольных товаров
				НоваяСтрока = ДокПоступление.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТовара, "Номенклатура, Количество, Цена, Сумма");
				НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
				СтрТовара.Подобрано = Истина;
				
				НоваяСтрокаПоставщика = ДокПоступление.ТоварыПоДаннымПоставщика.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПоставщика, НоваяСтрока, "Номенклатура, Количество, КоличествоУпаковок, Цена, Сумма");
			КонецЕсли;
		КонецЦикла;
		
		Пропущены = ТаблицаТоваров.НайтиСтроки(Новый Структура("Подобрано", Ложь));
		Если Пропущены.Количество() = 0 Тогда
			НулевыеСтроки = ДокПоступление.Товары.НайтиСтроки(Новый Структура("Количество", 0));
			Для Каждого Строка Из НулевыеСтроки Цикл
				ДокПоступление.Товары.Удалить(Строка);
			КонецЦикла;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Таб.АлкогольнаяПродукция КАК АлкогольнаяПродукция,
			               |	Таб.Номенклатура КАК Номенклатура,
			               |	Таб.ИдентификаторСтроки КАК ИдентификаторСтроки
			               |ПОМЕСТИТЬ ТоварыПоставщика
			               |ИЗ
			               |	&Таб КАК Таб
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВложенныйЗапрос.ИдентификаторСтроки КАК ИдентификаторСтроки,
			               |	Номенклатура.Ссылка КАК Номенклатура
			               |ИЗ
			               |	(ВЫБРАТЬ
			               |		ВЫРАЗИТЬ(ТоварыПоставщика.АлкогольнаяПродукция КАК Справочник.КлассификаторАлкогольнойПродукцииЕГАИС).Код КАК КодЕГАИС,
			               |		ТоварыПоставщика.ИдентификаторСтроки КАК ИдентификаторСтроки
			               |	ИЗ
			               |		ТоварыПоставщика КАК ТоварыПоставщика
			               |	ГДЕ
			               |		(ТоварыПоставщика.Номенклатура ЕСТЬ NULL
			               |				ИЛИ ВЫРАЗИТЬ(ТоварыПоставщика.Номенклатура КАК Справочник.Номенклатура).Код ЕСТЬ NULL)) КАК ВложенныйЗапрос
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			               |		ПО ВложенныйЗапрос.КодЕГАИС = Номенклатура.КодЕГАИС";
			
			Запрос.УстановитьПараметр("Таб", ДокПоступление.ТоварыПоДаннымПоставщика.Выгрузить());
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрПоставщик = ДокПоступление.ТоварыПоДаннымПоставщика.Найти(Выборка.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если СтрПоставщик <> Неопределено Тогда
					СтрПоставщик.Номенклатура = Выборка.Номенклатура;
				КонецЕсли;
			КонецЦикла;
			
			
			Товары = ДокПоступление.Товары.Выгрузить( , "АлкогольнаяПродукция, Количество");
			Товары.Свернуть("АлкогольнаяПродукция", "Количество");
			ТоварыПоставщика = ДокПоступление.ТоварыПоДаннымПоставщика.Выгрузить( , "АлкогольнаяПродукция, Количество");
			ТоварыПоставщика.Свернуть("АлкогольнаяПродукция", "Количество");
			
			ДокПоступление.ЕстьРасхождения = НЕ ОбщегоНазначения.КоллекцииИдентичны(Товары, ТоварыПоставщика);
				
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ОбработкаТабличнойЧастиТоварыКлиентСервер.СтруктураПараметровСтавкиНДСУчитыватьНДС(ДокПоступление));
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", ОбработкаТабличнойЧастиТоварыКлиентСервер.СтруктураПересчетаСуммыНДСВТЧ(ДокПоступление));
			СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
			
			СтруктураТЧ = Новый Структура;
			СтруктураТЧ.Вставить("СтрокиТЧ" , ДокПоступление.Товары);
			ОбработкаТабличнойЧастиТоварыСервер.ПриИзмененииРеквизитовВТЧСервер(СтруктураТЧ, СтруктураДействий, Неопределено);
					
			СтруктураТЧ.СтрокиТЧ = ДокПоступление.ТоварыПоДаннымПоставщика;
			ОбработкаТабличнойЧастиТоварыСервер.ПриИзмененииРеквизитовВТЧСервер(СтруктураТЧ, СтруктураДействий, Неопределено);
			
			ПриходЗаписанУдачно = Ложь;  
			
			Если ДокПоступление.ЕстьРасхождения = Истина Тогда
				НовыеПоступления[СтрПоставки.НомерСтроки - 1].Сообщение = "Ошибка: в Поступлении есть расхождение";
		  	Иначе	
				
				Попытка
					ДокПоступление.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
					НовыеПоступления[СтрПоставки.НомерСтроки - 1].Загружено = Истина;
					НовыеПоступления[СтрПоставки.НомерСтроки - 1].ПоступлениеТоваров = ДокПоступление.Ссылка;
					ПриходЗаписанУдачно = Истина;
				Исключение
					НовыеПоступления[СтрПоставки.НомерСтроки - 1].Сообщение = "Ошибка записи поступления: " + ОписаниеОшибки();
				КонецПопытки;
				
			КонецЕсли;
			
			//15-12-18
			
			УстановитьПривилегированныйРежим(Истина);
			
			Попытка
				ПараметрыТаблицаТоваров = Новый Структура("АлкогольнаяПродукция, ИдСправкиБ");
							
				Если ПриходЗаписанУдачно И ДанныеДокумента.ЕстьАлкоголь Тогда
			    	обТТНВходящая = ДокПоступление.ТТНВходящаяЕГАИС.ПолучитьОбъект();
		         	Для Каждого лСтрока Из  обТТНВходящая.Товары Цикл
					  //  Если ЗначениеЗаполнено(лСтрока.Номенклатура) Тогда
					  //  	 Продолжить;
					  //КонецЕсли;
					 
						ПараметрыТаблицаТоваров.Вставить("АлкогольнаяПродукция", лСтрока.АлкогольнаяПродукция);
						ПараметрыТаблицаТоваров.Вставить("ИдСправкиБ",			 лСтрока.НомерСправки2Поставщика);
			        				 					 
						МассивСтрок = ТаблицаТоваров.НайтиСтроки(ПараметрыТаблицаТоваров);
					
						Если НЕ МассивСтрок.Количество() = 0 Тогда
							лСтрока.Номенклатура = МассивСтрок[0].Номенклатура;
						Иначе
							лСтрока.Номенклатура = ВернутьНоменклатуруПоКодуЕгаис(лСтрока.АлкогольнаяПродукция.Код); 
						КонецЕсли;	 
					 КонецЦикла;
				 
					 обТТНВходящая.Записать(РежимЗаписиДокумента.Проведение);
					 
					 //02-06-20
					    					 
					 Запрос = Новый Запрос("ВЫБРАТЬ
					                       |	ТТНВходящаяЕГАИСАкцизныеМарки.АкцизнаяМарка КАК АкцизнаяМарка,
					                       |	ТТНВходящаяЕГАИСТовары.Номенклатура КАК Номенклатура
					                       |ИЗ
					                       |	Документ.ТТНВходящаяЕГАИС.АкцизныеМарки КАК ТТНВходящаяЕГАИСАкцизныеМарки
					                       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТТНВходящаяЕГАИС.Товары КАК ТТНВходящаяЕГАИСТовары
					                       |		ПО ТТНВходящаяЕГАИСАкцизныеМарки.Ссылка = ТТНВходящаяЕГАИСТовары.Ссылка
					                       |			И ТТНВходящаяЕГАИСАкцизныеМарки.Справка2 = ТТНВходящаяЕГАИСТовары.Справка2
					                       |			И ТТНВходящаяЕГАИСАкцизныеМарки.АкцизнаяМарка.Номенклатура <> ТТНВходящаяЕГАИСТовары.Номенклатура
					                       |ГДЕ
					                       |	ТТНВходящаяЕГАИСАкцизныеМарки.Ссылка = &ТТНВходящая");
					 
					 Запрос.Параметры.Вставить("ТТНВходящая",ДокПоступление.ТТНВходящаяЕГАИС);
					 Результат = Запрос.Выполнить();
					 Выборка = Результат.Выбрать();
					 Пока Выборка.Следующий() Цикл
						  обАкцизнаяМарка = Выборка.АкцизнаяМарка.ПолучитьОбъект();
						  обАкцизнаяМарка.Номенклатура = Выборка.Номенклатура;
						  обАкцизнаяМарка.Записать();
					 КонецЦикла;
					     		  
				 
				КонецЕсли;	
				
			Исключение	
			КонецПопытки;	
			
			УстановитьПривилегированныйРежим(Ложь);

			//Конец 02-06-20
				
		Иначе
			СписокКодов = "";
			Для Каждого Стр Из Пропущены Цикл
				СписокКодов = СписокКодов + Стр.НоменклатураКод + ", ";
			КонецЦикла;
			
			НовыеПоступления[СтрПоставки.НомерСтроки - 1].Сообщение = "Не найдена алк. продукция для номенклатуры " + Сред(СписокКодов, 1, СтрДлина(СписокКодов) - 2);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьПоставщиков(ТаблицаПоставщиков)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.ИНН,
	               |	Таб.КПП,
	               |	Таб.КодЕГАИС,
	               |	Таб.Наименование,
	               |	Таб.НаименованиеЕГАИС,
	               |	Таб.ПолнНаименование,
	               |	Таб.АдресЕГАИС,
	               |	Таб.КодРегиона,
	               |	Таб.Адрес
	               |ПОМЕСТИТЬ ОснРеквизиты
	               |ИЗ
	               |	&Таб КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОснРеквизиты.ИНН,
	               |	ОснРеквизиты.КПП,
	               |	ЕСТЬNULL(Контрагенты.Ссылка, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	               |	ЕСТЬNULL(КлассификаторОрганизацийЕГАИС.Ссылка, ЗНАЧЕНИЕ(Справочник.КлассификаторОрганизацийЕГАИС.ПустаяСсылка)) КАК ОрганизацияЕГАИС,
	               |	ОснРеквизиты.КодЕГАИС,
	               |	ОснРеквизиты.Наименование,
	               |	ОснРеквизиты.НаименованиеЕГАИС,
	               |	ОснРеквизиты.ПолнНаименование,
	               |	ОснРеквизиты.АдресЕГАИС,
	               |	ОснРеквизиты.КодРегиона,
	               |	ОснРеквизиты.Адрес
	               |ИЗ
	               |	ОснРеквизиты КАК ОснРеквизиты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |		ПО ОснРеквизиты.ИНН = Контрагенты.ИНН
	               |			И ОснРеквизиты.КПП = Контрагенты.КПП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторОрганизацийЕГАИС КАК КлассификаторОрганизацийЕГАИС
	               |		ПО ОснРеквизиты.КодЕГАИС = КлассификаторОрганизацийЕГАИС.Код";
	
	Запрос.УстановитьПараметр("Таб", ТаблицаПоставщиков);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ГруппаРодитель = Неопределено;
	ВозможныеРодители = Справочники.Контрагенты.Выбрать( , , Новый Структура("Наименование", "Поставщики"));
	Пока ВозможныеРодители.Следующий() Цикл
		Если ВозможныеРодители.ЭтоГруппа Тогда
			ГруппаРодитель = ВозможныеРодители.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ГруппаРодитель = Неопределено Тогда
		Группа = Справочники.Контрагенты.СоздатьГруппу();
		Группа.Наименование = "Поставщики";
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
		Поставщик = Выборка.Контрагент;
		Если НЕ ЗначениеЗаполнено(Поставщик) Тогда
			ПоставщикОбъект = Справочники.Контрагенты.СоздатьЭлемент();
			ПоставщикОбъект.Родитель = ГруппаРодитель;
			ПоставщикОбъект.ИНН = Выборка.ИНН;
			ПоставщикОбъект.КПП = Выборка.КПП;
			ПоставщикОбъект.Наименование = Выборка.Наименование;
			ПоставщикОбъект.НаименованиеПолное = Выборка.ПолнНаименование;
			Если СтрДлина(Выборка.ИНН) = 12 Тогда
				ПоставщикОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
			Иначе
				ПоставщикОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			КонецЕсли;
			ПоставщикОбъект.СтранаРегистрации = Справочники.СтраныМира.Россия;
			Попытка
				ПоставщикОбъект.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно создать поставщика ИНН/КПП " + Выборка.ИНН + "/" + Выборка.КПП + ": " + ОписаниеОшибки());  
				Продолжить;
			КонецПопытки;
			
			Поставщик = ПоставщикОбъект.Ссылка;
		КонецЕсли;	
		
		ОрганизацияЕГАИС = Выборка.ОрганизацияЕГАИС;
		Если НЕ ЗначениеЗаполнено(ОрганизацияЕГАИС) Тогда
			ОргЕГАИСОбъект = Справочники.КлассификаторОрганизацийЕГАИС.СоздатьЭлемент();
			ОргЕГАИСОбъект.Код = Выборка.КодЕГАИС;
			ОргЕГАИСОбъект.ИНН = Выборка.ИНН;
			ОргЕГАИСОбъект.КПП = Выборка.КПП;
			ОргЕГАИСОбъект.КодРегиона = Выборка.КодРегиона;
			ОргЕГАИСОбъект.КодСтраны = "643";
			ОргЕГАИСОбъект.Наименование = Выборка.НаименованиеЕГАИС;
			ОргЕГАИСОбъект.НаименованиеПолное = Выборка.ПолнНаименование;
			ОргЕГАИСОбъект.ПредставлениеАдреса = Выборка.АдресЕГАИС;
			Если СтрДлина(Выборка.ИНН) = 12 ТОГДА
				ОргЕГАИСОбъект.ТипОрганизации = Перечисления.ТипыОрганизацийЕГАИС.ИндивидуальныйПредпринимательРФ;
			Иначе
				ОргЕГАИСОбъект.ТипОрганизации = Перечисления.ТипыОрганизацийЕГАИС.ЮридическоеЛицоРФ;
			КонецЕсли;
			Попытка
				ОргЕГАИСОбъект.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно создать организацию ЕГАИС " + Выборка.КодЕГАИС + ": " + ОписаниеОшибки());  
				Продолжить;
			КонецПопытки;
			ОрганизацияЕГАИС = ОргЕГАИСОбъект.Ссылка;
		КонецЕсли;
		
		//Запись = РегистрыСведений.СоответствиеОрганизацийЕГАИС.СоздатьМенеджерЗаписи();
		//Запись.ОрганизацияЕГАИС = ОрганизацияЕГАИС;
		//Запись.Контрагент = Поставщик;
		//Запись.Записать(Истина);
					
		УстановитьПривилегированныйРежим(Истина);
		 		
		Спр = ОрганизацияЕГАИС.ПолучитьОбъект();
		Спр.СоответствуетОрганизации = ТипЗнч(Поставщик) = Тип("СправочникСсылка.Организации");
		Спр.Контрагент = Поставщик;
		Спр.ТорговыйОбъект = ?(Спр.СоответствуетОрганизации, ПараметрыСеанса.ТекущийМагазин, Неопределено);
	
		Спр.Записать();

		
	КонецЦикла;
	
	
	Для Каждого Строка Из ТаблицаПоставщиков Цикл
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьРегистрМинимальныеЦены(ПолученныеДанные)

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МинимальныеЦены.НачДата,
	                      |	МинимальныеЦены.КонДата,
	                      |	МинимальныеЦены.ВидПродукции.Код,
	                      |	МинимальныеЦены.КрепостьИнтервал1,
	                      |	МинимальныеЦены.КрепостьИнтервал2,
	                      |	МинимальныеЦены.Цена
	                      |ИЗ
	                      |	РегистрСведений.МинимальныеЦены КАК МинимальныеЦены");
						  
	ТЗНач = Запрос.Выполнить().Выгрузить();
	
	Если ОбщегоНазначения.КоллекцииИдентичны(ТЗНач, ПолученныеДанные) Тогда
		Возврат;
	КонецЕсли;
		
	ПолученныеДанные.Колонки.Добавить("ВидПродукции",Новый ОписаниеТипов("СправочникСсылка.ВидыАлкогольнойПродукции"));
	
	Для Каждого Строка Из ПолученныеДанные Цикл
		Строка.ВидПродукции = Справочники.ВидыАлкогольнойПродукции.НайтиПоКоду(Строка.ВидПродукцииКод);
	КонецЦикла;	
	
	НаборЗаписей=РегистрыСведений.МинимальныеЦены.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(ПолученныеДанные);
	НаборЗаписей.Записать();
	 		   	
КонецПроцедуры	

