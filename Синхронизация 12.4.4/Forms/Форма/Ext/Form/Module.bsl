            Попытка
				ПользовательИБ.Записать();	
			Исключение
	   		КонецПопытки; 
		КонецЕсли;	
	КонецЦикла;	
	    
КонецПроцедуры	

&НаСервере
Функция ВернутьСправку2(пАкцизнаяМарка)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТТНВходящаяЕГАИСАкцизныеМарки.Справка2 КАК Справка2
	                      |ИЗ
	                      |	Документ.ТТНВходящаяЕГАИС.АкцизныеМарки КАК ТТНВходящаяЕГАИСАкцизныеМарки
	                      |ГДЕ
	                      |	ТТНВходящаяЕГАИСАкцизныеМарки.АкцизнаяМарка = &АкцизнаяМарка");
	
	Запрос.Параметры.Вставить("АкцизнаяМарка",пАкцизнаяМарка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
	КонецЕсли;	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Справка2; 
	
КонецФункции

&НаСервере
Функция СформироватьДокументыОстаткиЕГАИССервис()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ОстаткиЕГАИС.ВидДокумента КАК ВидДокумента
	             |ИЗ
	             |	Документ.ОстаткиЕГАИС КАК ОстаткиЕГАИС
	             |ГДЕ
	             |	НЕ ОстаткиЕГАИС.ПометкаУдаления
	             |	И ОстаткиЕГАИС.Дата >= &ТекущийДень";
	Запрос.УстановитьПараметр("ТекущийДень",НачалоДня(ТекущаяДата()));
	
	Результат=Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	    	
	
	ЗапросОстатковЕГАИС = Документы.ОстаткиЕГАИС.СоздатьДокумент();
    ЗапросОстатковЕГАИС.Комментарий = "Создан обработкой синхронизации";
	ЗапросОстатковЕГАИС.Дата = ТекущаяДата();
	ЗапросОстатковЕГАИС.Ответственный    = Справочники.Пользователи.Автомат;
	ЗапросОстатковЕГАИС.ТорговыйОбъект   = ЗначениеНастроекПовтИсп.МагазинПоУмолчанию(ЗапросОстатковЕГАИС.ТорговыйОбъект);
	ЗапросОстатковЕГАИС.Организация      = ЗначениеНастроекПовтИсп.ОрганизацияПоУмолчанию(ЗапросОстатковЕГАИС.Организация, ЗапросОстатковЕГАИС.Ответственный);
	ЗапросОстатковЕГАИС.ОрганизацияЕГАИС = Справочники.КлассификаторОрганизацийЕГАИС.ОрганизацияЕГАИСПоОрганизацииИТорговомуОбъекту(ЗапросОстатковЕГАИС.Организация, ЗапросОстатковЕГАИС.ТорговыйОбъект);
	ЗапросОстатковЕГАИС.ВидДокумента 	 = Перечисления.ВидыДокументовЕГАИС.ЗапросОстатковВРегистре1;
	ЗапросОстатковЕГАИС.Записать(РежимЗаписиДокумента.Проведение);	
	
	ЭтотОбъект.ОстаткиСклад=ЗапросОстатковЕГАИС.Ссылка;
	
	ЗапросОстатковЕГАИС = Документы.ОстаткиЕГАИС.СоздатьДокумент();
    ЗапросОстатковЕГАИС.Комментарий = "Создан обработкой синхронизации";
	ЗапросОстатковЕГАИС.Дата = ТекущаяДата();
	ЗапросОстатковЕГАИС.Ответственный    = Справочники.Пользователи.Автомат;
	ЗапросОстатковЕГАИС.ТорговыйОбъект   = ЗначениеНастроекПовтИсп.МагазинПоУмолчанию(ЗапросОстатковЕГАИС.ТорговыйОбъект);
	ЗапросОстатковЕГАИС.Организация      = ЗначениеНастроекПовтИсп.ОрганизацияПоУмолчанию(ЗапросОстатковЕГАИС.Организация, ЗапросОстатковЕГАИС.Ответственный);
	ЗапросОстатковЕГАИС.ОрганизацияЕГАИС = Справочники.КлассификаторОрганизацийЕГАИС.ОрганизацияЕГАИСПоОрганизацииИТорговомуОбъекту(ЗапросОстатковЕГАИС.Организация, ЗапросОстатковЕГАИС.ТорговыйОбъект);
	ЗапросОстатковЕГАИС.ВидДокумента = Перечисления.ВидыДокументовЕГАИС.ЗапросОстатковВРегистре2;
	ЗапросОстатковЕГАИС.Записать(РежимЗаписиДокумента.Проведение);	
	
	ЭтотОбъект.ОстаткиТорговыйЗал=ЗапросОстатковЕГАИС.Ссылка;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ВернутьНоменклатуруПоКодуЕгаис(ПКодЕГАИС)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	Номенклатура.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Номенклатура КАК Номенклатура
	                      |ГДЕ
	                      |	НЕ Номенклатура.ПометкаУдаления
	                      |	И Номенклатура.КодЕГАИС = &КодЕГАИС");
	
	Запрос.Параметры.Вставить("КодЕГАИС",СокрЛП(ПКодЕГАИС));

	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции	

