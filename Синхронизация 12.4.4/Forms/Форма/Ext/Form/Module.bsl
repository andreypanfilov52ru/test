// ИСПОЛНИТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Функция НачатьПечатьЦенников(СсылкаНаДокумент)
	СписокДокументов = Новый Массив;
	СписокДокументов.Добавить(СсылкаНаДокумент);
	
	ПараметрыПечатиЦенников = УправлениеПечатьюРТ.СтруктураПараметровПечатиЦенниковИЭтикеток();
	ПараметрыПечатиЦенников.ИмяПроцедурыПодготовкиСтруктурыДанных = "УправлениеПечатьюРТВызовСервера.ПодготовитьСтруктуруДанныхЦенниковИЭтикетокДляУстановкиЦен";
	ПараметрыПечатиЦенников.ИмяДокумента = "УстановкаЦенНоменклатуры";
	ПараметрыПечатиЦенников.УстановитьРежим = "ПечатьЦенников";
	
	СтруктураДанных = ПолучитьИзВременногоХранилища(УправлениеПечатьюРТ.СтруктураДанныхЦенниковИЭтикетокДляУстановкиЦен(СписокДокументов, Новый Массив, ПараметрыПечатиЦенников));
	СтруктураДанных.СтруктураДействий.Вставить("ЗаполнитьМагазин", ПараметрыСеанса.ТекущийМагазин);
	
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("АдресВХранилище", ПоместитьВоВременноеХранилище(СтруктураДанных));
	
	Возврат ПараметрыЗапуска;
КонецФункции

&НаСервере
Процедура ВыполнитьОбменНаСервере()
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ВыполнитьОбмен();
	ЗначениеВРеквизитФормы(ОбъектОбработки, "Объект");
	Элементы.ЗагруженныеДанные.Заголовок = "Загруженные поступления (" + Объект.НовыеПоступления.Количество() + ")";
	Если Объект.НовыеПоступления.Количество() > 0 Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ЗагруженныеДанные;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗагрузкуНоменклатуры(КодНоменклатуры)
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ОбъектОбработки.ЗапроситьНоменклатуруПоКоду(КодНоменклатуры);
	
	Возврат ЗначениеЗаполнено(Справочники.Номенклатура.НайтиПоКоду(КодНоменклатуры));
КонецФункции

////////////////////////////////////////////////////////////////////////////////////////////////////////////
//ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ДОКУМЕНТАМИ ЕГАИС

&НаСервере
Функция ПодготовитьВходящуюТТНДляПодтверждения(ТТНВходящаяЕГАИС) 
	
    	УстановитьПривилегированныйРежим(Истина);
	
	    лОбъект 						= ТТНВходящаяЕГАИС.ПолучитьОбъект();
		
		//
		Попытка
			
			ПоступлениеТоваров 		 =  ТТНВходящаяЕГАИС.ДокументОснование;
			ПоступлениеТоваровТовары =  ПоступлениеТоваров.Товары;
						
			лТребЗапистьТТН = Ложь;
			Для Каждого лСтрока Из  лОбъект.Товары Цикл
				Если ЗначениеЗаполнено(лСтрока.Номенклатура) Тогда
					 Продолжить;
				КонецЕсли;
				
				лТребЗапистьТТН = Истина;
				
				НайденнаяСтрока = ПоступлениеТоваровТовары.Найти(лСтрока.АлкогольнаяПродукция,"АлкогольнаяПродукция"); 
				Если Не НайденнаяСтрока = Неопределено Тогда 
					лСтрока.Номенклатура = НайденнаяСтрока.Номенклатура; 
				Иначе	
					лСтрока.Номенклатура = ВернутьНоменклатуруПоКодуЕгаис(лСтрока.АлкогольнаяПродукция.Код); 
				КонецЕсли;	
					
			КонецЦикла;
			
			Если лТребЗапистьТТН Тогда
		    	лОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;	
						
		Исключение	
        КонецПопытки;
		
		//
		
		ДанныеПроверяемогоДокумента 	= Документы.ТТНВходящаяЕГАИС.ВходящееДеревоУпаковок(ТТНВходящаяЕГАИС);

		ДеревоУпаковок 					= ДанныеПроверяемогоДокумента.ДеревоУпаковок;
				
	    ДеревоУпаковок.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
		ДеревоУпаковок.Колонки.Добавить("КоличествоАкцизныхМарок", ОбщегоНазначения.ОписаниеТипаЧисло(15));
		ДеревоУпаковок.Колонки.Добавить("Коэффициент", ОбщегоНазначения.ОписаниеТипаЧисло(15,4));   			
		
		ТаблицаНеМаркируемойПродукции  	= ДанныеПроверяемогоДокумента.ТоварыБезАкцизныхМарок;
		ТаблицаНеМаркируемойПродукции.Колонки.Добавить("КоличествоФактическое", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
				
		//ШтрихкодыУпаковок = ИнтеграцияЕГАИС.ШтрихкодыУпаковок(ИнтеграцияЕГАИС.ЗначенияШтрихкодовИзДереваУпаковок(ДеревоУпаковок));
		ШтрихкодыУпаковок = ШтрихкодированиеИС.ШтрихкодыУпаковок(ИнтеграцияЕГАИС.ЗначенияШтрихкодовИзДереваУпаковок(ДеревоУпаковок));
			                       		
		
		НачатьТранзакцию();
	
		Попытка
		    лОбъект.АкцизныеМарки.Очистить();
			
			ШтрихкодированиеЕГАИС.СоздатьШтрихкодыУпаковок(ДеревоУпаковок,ШтрихкодыУпаковок,Ложь, лОбъект.Грузополучатель);
				
			//Справочники.ШтрихкодыУпаковокТоваров.СоздатьШтрихкодыУпаковок(ДеревоУпаковок,ШтрихкодыУпаковок, Ложь, лОбъект.Грузополучатель);
		
			Документы.ТТНВходящаяЕГАИС.ЗаполнитьАкцизныеМарки(лОбъект,ДеревоУпаковок);
			Документы.ТТНВходящаяЕГАИС.ЗаполнитьФактическоеКоличество(лОбъект,ДеревоУпаковок,ТаблицаНеМаркируемойПродукции);
		
			лОбъект.СтатусПроверкиИПодбора = Перечисления.СтатусыПроверкиИПодбораИС.Завершено;    
			
			Для Каждого лСтрока Из  лОбъект.Товары Цикл
				лСтрока.КоличествоФакт = лСтрока.Количество;
			КонецЦикла;	
			
			лОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			ПараметрыОбновленияСтатуса = ИнтеграцияЕГАИС.ПараметрыОбновленияСтатуса();
			ПараметрыОбновленияСтатуса.ОбновлятьДвижения = Ложь;
			ПараметрыОбновленияСтатуса.СтатусОбработки   = Перечисления.СтатусыОбработкиСообщенийЕГАИС.ПринятИзЕГАИС;
			ПараметрыОбновленияСтатуса.ДокументОбъект    = лОбъект;
		
			Документы.ТТНВходящаяЕГАИС.ОбновитьСтатусПослеПолученияДанных(лОбъект.Ссылка, Перечисления.ВидыДокументовЕГАИС.ТТН, ПараметрыОбновленияСтатуса);
		
			ЗафиксироватьТранзакцию();
			
			Возврат Истина;
		
		Исключение
		
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось сохранить результаты проверки в документе: %1 по причине: %2'"),лОбъект.Ссылка,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ОтменитьТранзакцию();
			
			Возврат Ложь;
			
		КонецПопытки;
		
КонецФункции	

&НаСервере
Процедура ВыполнитьОбменЕГАИС()

	//ИнтеграцияЕГАИСВызовСервера
	ОбменДаннымиЕГАИСВызовСервера.ВыполнитьОбмен(Неопределено);
	  
КонецПроцедуры

&НаКлиенте  
Процедура ПодтвердитьТТНВходящиеЕГАИС()
	 	
	Если ЭтотОбъект.ТТНВходящиеЕГАИСКПодтверждению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	Для Каждого Строка ИЗ ЭтотОбъект.ТТНВходящиеЕГАИСКПодтверждению Цикл
		
		лРезультат = ПодготовитьВходящуюТТНДляПодтверждения(Строка.ТТНВходящаяЕГАИС);
		Если НЕ лРезультат Тогда 
			Продолжить;
		КонецЕсли;	
		
		СтруктураРасхождений = ПроверитьРасхожденияТоваровПоступленияТТН_ЕГАИС(Строка.ТТНВходящаяЕГАИС);
		
		Если СтруктураРасхождений.ЕстьРасхожденияБольшеТТН ИЛИ СтруктураРасхождений.ЕстьРасхожденияМеньшеТТН Тогда
			
			Если НЕ ЗаполнитьРасхожденияВДокументеТТНВходящая(Строка.ТТНВходящаяЕГАИС) Тогда
				Продолжить;
			КонецЕсли;	
			
			ОбменДаннымиЕГАИСКлиент.ПодготовитьКПередаче(Строка.ТТНВходящаяЕГАИС,ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ПодтвердитеПолучениеАктРасхождений"));
			
		Иначе	
			
			ОбменДаннымиЕГАИСКлиент.ПодготовитьКПередаче(Строка.ТТНВходящаяЕГАИС,ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ПодтвердитеПолучениеАктПодтверждения"));
			
		КонецЕсли;	
		   		
	КонецЦикла;	
	   	
	ЭтотОбъект.ТТНВходящиеЕГАИСКПодтверждению.Очистить();
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры	

&НаКлиенте
Процедура СформироватьАктыСписанияЕГАИСРеализацияДляКафе()

	СформироватьАктыСписанияЕГАИСРеализацияДляКафеСервер();

КонецПроцедуры	

&НаКлиенте
Процедура ПодтвердитьАктыСписанияЕГАИС()
	 	
	Если ЭтотОбъект.АктСписанияЕГАИСКПодтверждению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовЕГАИС.АктСписанияИзРегистра2");
	
	
	Для Каждого Строка ИЗ ЭтотОбъект.АктСписанияЕГАИСКПодтверждению Цикл
		
		ДокументСсылка = Строка.АктСписанияЕГАИС;
		
		Если НЕ ПроверитьАктСписанияЕГАИСПередПодтверждением(ДокументСсылка) Тогда
			Продолжить;
		КонецЕсли;	
		
		
		ОбменДаннымиЕГАИСКлиент.ПодготовитьКПередаче(ДокументСсылка,ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ПередайтеДанные"));
		
	КонецЦикла;		
	
	ЭтотОбъект.АктСписанияЕГАИСКПодтверждению.Очистить();
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры
	
&НаКлиенте
Процедура СформироватьДокументыОстаткиЕГАИС()
	
	Если Не Объект.ЗапрашиватьОстаткиЕгаис Тогда
		Возврат;
	КонецЕсли;	
			
	Если НЕ СформироватьДокументыОстаткиЕГАИССервис() Тогда
		Возврат;
	КонецЕсли;	
	
	Попытка 
		ОбменДаннымиЕГАИСКлиент.ПодготовитьКПередаче(ЭтотОбъект.ОстаткиСклад,ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ЗапроситеОстатки"));
	Исключение
	КонецПопытки;
	
	Попытка 
		ОбменДаннымиЕГАИСКлиент.ПодготовитьКПередаче(ЭтотОбъект.ОстаткиТорговыйЗал,ПредопределенноеЗначение("Перечисление.ДальнейшиеДействияПоВзаимодействиюЕГАИС.ЗапроситеОстатки"));
	Исключение
	КонецПопытки;
	       	  	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Запрос номенклатуры по кодам

&НаСервере
Процедура ЗапросНоменклатурыЗагрузитьНаСервере()  
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");

	
	Узел = ПланыОбмена.РозницаСтандартАлко.ЭтотУзел();
	УзелЦентр = ПланыОбмена.РозницаСтандартАлко.НайтиПоКоду("ЦЕНТР");
	Если НЕ ЗначениеЗаполнено(УзелЦентр) Тогда
		Возврат;
	КонецЕсли;
	
	WSПрокси = ОбъектОбработки.ИнициализацияВебСервиса(УзелЦентр);
	Если WSПрокси = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
    ЗапросНоменклатурыЗагруженныеДанные.Очистить();
	
	НомерСтроки = 2;  
	СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
	ЗаполненыНоменклатураКод = ЗначениеЗаполнено(ТабличныйДокументЗапросНоменклатуры.Область("R" + СтроковыйНомер).Текст);
		
    Пока ЗаполненыНоменклатураКод Цикл
		
		НоваяСтрока = ЗапросНоменклатурыЗагруженныеДанные.Добавить();
         	
		Попытка
			НоваяСтрока.Код =	ТабличныйДокументЗапросНоменклатуры.Область("R" + СтроковыйНомер).Текст;
			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	
		КодНоменклатуры = ВРег(СтрЗаменить(НоваяСтрока.Код, " ", "")); 
		
		//Загрузка номенклатуры
		
		СоответствуетШаблону = (СтрДлина(КодНоменклатуры) = 5) ИЛИ (СтрДлина(КодНоменклатуры) = 6);
		ДопустимыеСимволы = "0123456789Т";//код номенклатуры сторонних поставщиков начинается с Т
		Для Индекс = 1 По СтрДлина(КодНоменклатуры) Цикл
			Если Найти(ДопустимыеСимволы, Сред(КодНоменклатуры, Индекс, 1)) = 0 Тогда
				СоответствуетШаблону = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ СоответствуетШаблону Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Код номенклатуры не соответствует шаблону - должен состоять из 5 цифр или буквы ""Т"" и 4 цифр");
		Иначе	  
			
			РезультатОбмена = WSПрокси.ПолучитьНоменклатуру(Узел.Код, КодНоменклатуры);
			Попытка
				ДанныеНоменклатуры = РезультатОбмена.Получить();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка загрузки номенклатуры: " + ОписаниеОшибки());
			КонецПопытки;
			
			Если ТипЗнч(ДанныеНоменклатуры) = Тип("Структура") Тогда
				ОбъектОбработки.ЗагрузитьНоменклатуру(ДанныеНоменклатуры);
		        НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоКоду(КодНоменклатуры);
			КонецЕсли;
	        			
		КонецЕсли;
        	
		
		НомерСтроки = НомерСтроки + 1;
		СтроковыйНомер = Формат(НомерСтроки, "ЧН=0; ЧГ=0");
		
		Попытка
			ЗаполненыНоменклатураКод =
				ЗначениеЗаполнено(ТабличныйДокументЗапросНоменклатуры.Область("R" + СтроковыйНомер).Текст);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
         		
	КонецЦикла;	
	
КонецПроцедуры

