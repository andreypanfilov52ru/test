&НаСервере
Функция ЗапросПроверкиСписанияАкцизнойМаркиДляКафе(КодАкцизнойМарки) Экспорт
	 		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодАкцизнойМарки",                 КодАкцизнойМарки);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АктСписанияЕГАИСАкцизныеМарки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктСписанияЕГАИС.АкцизныеМарки КАК АктСписанияЕГАИСАкцизныеМарки
	|ГДЕ
	|	АктСписанияЕГАИСАкцизныеМарки.Ссылка.Проведен
	|	И АктСписанияЕГАИСАкцизныеМарки.АкцизнаяМарка.ЗначениеШтрихкода = &КодАкцизнойМарки";
	
	Результат =  Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

