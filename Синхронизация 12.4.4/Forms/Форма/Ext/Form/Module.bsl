Функция ЕГАИСВключен()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Константы.ВестиСведенияДляДекларацийПоАлкогольнойПродукции.Получить();

КонецФункции

&НаСервере
Функция ПроверитьАктСписанияЕГАИСПередПодтверждением(ДокументСсылка)
	
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Истина;
	
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Комментарий = "Автоматическая обработка"; 
	ДокОбъект.Ответственный = Справочники.Пользователи.Автомат;
	
	Если НЕ ДокОбъект.Проведен Тогда
		Для Каждого Строка ИЗ ДокОбъект.Товары Цикл
			Строка.АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(Строка.Номенклатура.КодЕГАИС);
			
			Если НЕ ЗначениеЗаполнено(Строка.АлкогольнаяПродукция) Тогда
				
				ДокОбъект.ОбменДанными.Загрузка = Истина;
							
				Попытка 
					ДокОбъект.Записать();
				Исключение
				КонецПопытки;	
				
				ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Ложь;				
							
				Возврат Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;	
			
	Попытка 
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Ложь;
		Возврат Ложь;
	КонецПопытки;	
	
	ПараметрыСеанса.ПропуститьПроверкуЗапретаИзменения = Ложь;
	
	Возврат Истина;
	
КонецФункции	

&НаКлиенте
Процедура ВыгрузкаДокумента_Завершение(Результат, ДополнительныеПараметры) Экспорт
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьФайлыВнешнихОбработок()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Для Каждого Строка Из Объект.ФайлыВнешнихОбработок Цикл
			
			Наименование   = Строка.Наименование;
			ДвоичныеДанные = Base64Значение(Строка.Данные);
			Расширение 	   = Строка.Расширение;
			
			ИмяВременногоФайла = КаталогВременныхФайлов()+Наименование+"."+Расширение;
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			
			АдресДанныхОбработки 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
			ДвоичныеДанныеОбработки = ПолучитьИзВременногоХранилища(АдресДанныхОбработки);
			
			текСправочник = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(Строка.Наименование);
			
			Если текСправочник = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка() Тогда
				обСправочник = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
				обСправочник.Наименование = Наименование;
				обСправочник.Ответственный = Справочники.Пользователи.Автомат;
			Иначе	 
				обСправочник = текСправочник.ПолучитьОбъект(); 
			КонецЕсли;	
			
			обСправочник.Публикация = Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется;
			обСправочник.ХранилищеОбработки = Новый ХранилищеЗначения(ДвоичныеДанныеОбработки, Новый СжатиеДанных(9));
			
			ПараметрыРегистрации = Новый Структура;
			ПараметрыРегистрации.Вставить("Успех", Ложь);
			ПараметрыРегистрации.Вставить("АдресДанныхОбработки", АдресДанныхОбработки);
			ПараметрыРегистрации.Вставить("ОтключатьПубликацию", Ложь);
			ПараметрыРегистрации.Вставить("ОтключатьКонфликтующие", Ложь);
			ПараметрыРегистрации.Вставить("Конфликтующие", Новый СписокЗначений);
			ПараметрыРегистрации.Вставить("ЭтоОтчет",?(Расширение="erf",Истина,Ложь));
			ПараметрыРегистрации.Вставить("ИмяФайла",Наименование+"."+Расширение);
			
			РезультатРегистрации = ДополнительныеОтчетыИОбработки.ЗарегистрироватьОбработку(обСправочник, ПараметрыРегистрации);
			
			обСправочник.Разделы.Очистить();
			новСтрокаРазделы = обСправочник.Разделы.Добавить();
			новСтрокаРазделы.Раздел = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоНаименованию("Продажи (Подсистема)");
			
			обСправочник.Записать();
			
			//Прописать пользователей
			
			Запись = РегистрыСведений.ПользовательскиеНастройкиДоступаКОбработкам.СоздатьМенеджерЗаписи();
			Запись.ДополнительныйОтчетИлиОбработка  = обСправочник.Ссылка;
			Запись.ИдентификаторКоманды             = обСправочник.Команды[0].Идентификатор;
			Запись.Пользователь                     = Справочники.Пользователи.НайтиПоНаименованию("Администратор");
			Запись.Доступно                         = Истина;
			Запись.Записать(Истина);
			
			Если Строка.Товаровед Тогда
				Запись = РегистрыСведений.ПользовательскиеНастройкиДоступаКОбработкам.СоздатьМенеджерЗаписи();
				Запись.ДополнительныйОтчетИлиОбработка  = обСправочник.Ссылка;
				Запись.ИдентификаторКоманды             = обСправочник.Команды[0].Идентификатор;
				Запись.Пользователь                     = Справочники.Пользователи.НайтиПоНаименованию("Товаровед");
				Запись.Доступно                         = Истина;
				Запись.Записать(Истина);
			КонецЕсли;	
			
			Если Строка.ТорговыйПредставитель Тогда
				Запись = РегистрыСведений.ПользовательскиеНастройкиДоступаКОбработкам.СоздатьМенеджерЗаписи();
				Запись.ДополнительныйОтчетИлиОбработка  = обСправочник.Ссылка;
				Запись.ИдентификаторКоманды             = обСправочник.Команды[0].Идентификатор;
				Запись.Пользователь                     = Справочники.Пользователи.НайтиПоНаименованию("Торговый представитель");
				Запись.Доступно                         = Истина;
				Запись.Записать(Истина);
			КонецЕсли;	
			
		КонецЦикла;
		
		Объект.ФайлыВнешнихОбработок.Очистить();
		
	Исключение
	КонецПопытки;
		
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокТТНВходящиеЕГАИСКПодтверждению()
	
	УстановитьПривилегированныйРежим(Истина);
	
	лТТНВходящиеЕГАИСКПодтверждению = ЭтотОбъект.ТТНВходящиеЕГАИСКПодтверждению;
	лТТНВходящиеЕГАИСКПодтверждению.Очистить();
		
	ЭтоКафе = Константы.ТрадицияКонфигурацияДляКафе.Получить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Результат.ТТНВходящаяЕГАИС КАК ТТНВходящаяЕГАИС,
	                      |	Результат.ТТНВходящаяЕГАИС.Дата КАК ТТНВходящаяЕГАИСДата,
	                      |	Результат.ВидОперации КАК ВидОперации,
	                      |	Результат.ИдентификаторЕГАИС КАК ИдентификаторЕГАИС,
	                      |	Результат.СтатусОбработки КАК СтатусОбработки,
	                      |	Результат.ТТНВходящаяЕГАИС.ДокументОснование КАК ДокументОснование
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ЕГАИС.Ссылка КАК ТТНВходящаяЕГАИС,
	                      |		ЕГАИС.ВидОперации КАК ВидОперации,
	                      |		ЕГАИС.ИдентификаторЕГАИС КАК ИдентификаторЕГАИС,
	                      |		СтатусыДокументовЕГАИС.Статус КАК СтатусОбработки
	                      |	ИЗ
	                      |		Документ.ТТНВходящаяЕГАИС КАК ЕГАИС
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	                      |			ПО ЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
	                      |	ГДЕ
	                      |		ЕГАИС.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийТТНВходящейЕГАИС.ПриходнаяНакладная)
	                      |		И ЕГАИС.Дата МЕЖДУ &ДатаНачало И &ТекущаяДата
	                      |		И СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиТТНВходящейЕГАИС.ПринятИзЕГАИС)
	                      |		И ЕГАИС.ДатаТТН <= &ТекущаяДата) КАК Результат
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Результат.ТТНВходящаяЕГАИС,
	                      |	Результат.СтатусОбработки,
	                      |	Результат.ИдентификаторЕГАИС,
	                      |	Результат.ВидОперации,
	                      |	Результат.ТТНВходящаяЕГАИС.Дата,
	                      |	Результат.ТТНВходящаяЕГАИС.ДокументОснование");
			
	Запрос.Параметры.Вставить("ТекущаяДата",КонецДня(ТекущаяДата()));
	Запрос.Параметры.Вставить("ДатаНачало",НачалоДня(ТекущаяДата() -60*60*24*45));
		
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		 ТТНВходящаяЕГАИС =  Выборка.ТТНВходящаяЕГАИС;
		 
		 Попытка
		 
		 	лОбъект 						= ТТНВходящаяЕГАИС.ПолучитьОбъект();
		 	ДанныеПроверяемогоДокумента 	= Документы.ТТНВходящаяЕГАИС.ВходящееДеревоУпаковок(ТТНВходящаяЕГАИС);
		 	ДеревоУпаковок 					= ДанныеПроверяемогоДокумента.ДеревоУпаковок;
		 
		 	ПрисутствуетАкцизныйТовар = ?(ДеревоУпаковок.Строки.Количество() = 0,Ложь,Истина);
		                                                                                  
		 	Если ПрисутствуетАкцизныйТовар Тогда
				Если НЕ ЗначениеЗаполнено(Выборка.ДокументОснование) Тогда
					Продолжить;
				КонецЕсли;
	     	КонецЕсли;	 
		 
		 	НоваяСтрока = лТТНВходящиеЕГАИСКПодтверждению.Добавить();
		 	ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
		 	НоваяСтрока.АкцизныйТовар = ПрисутствуетАкцизныйТовар;
		Исключение	
		КонецПопытки;	
			
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокАктСписанияЕГАИСКПодтверждению(ЗаВесьПериод=Ложь)
	
	лАктСписанияЕГАИСКПодтверждению = ЭтотОбъект.АктСписанияЕГАИСКПодтверждению;
	лАктСписанияЕГАИСКПодтверждению.Очистить();
	    	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	АктСписанияЕГАИС.Ссылка КАК АктСписанияЕГАИС
	                      |ИЗ
	                      |	Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовЕГАИС КАК СтатусыДокументовЕГАИС
	                      |		ПО АктСписанияЕГАИС.Ссылка = СтатусыДокументовЕГАИС.Документ
	                      |ГДЕ
	                      |	АктСписанияЕГАИС.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЕГАИС.АктСписанияИзРегистра2)
	                      |	И АктСписанияЕГАИС.ПричинаСписания = ЗНАЧЕНИЕ(Перечисление.ПричиныСписанийЕГАИС.Реализация)
	                      |	И АктСписанияЕГАИС.Дата <= &ДатаОкончания
	                      |	И АктСписанияЕГАИС.Дата >= &ДатаНачала
	                      |	И НЕ АктСписанияЕГАИС.ПометкаУдаления
	                      |	И (СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиАктаСписанияЕГАИС.Черновик)
	                      |			ИЛИ СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиАктаСписанияЕГАИС.ОшибкаПередачи)
	                      |			ИЛИ СтатусыДокументовЕГАИС.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбработкиАктаСписанияЕГАИС.ОшибкаПроведенияЕГАИС))
	                      |	И НЕ АктСписанияЕГАИС.Ответственный = &Автомат
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	АктСписанияЕГАИС.Дата");
	
	Запрос.Параметры.Вставить("Автомат",Справочники.Пользователи.Автомат);
	
	Если ЗаВесьПериод Тогда
		Запрос.Параметры.Вставить("ДатаНачала",Дата(1, 1, 1));    
		Запрос.Параметры.Вставить("ДатаОкончания",ТекущаяДата());
	Иначе	
		Запрос.Параметры.Вставить("ДатаНачала",НачалоДня(ТекущаяДата() -60*60*24*30));    
		Запрос.Параметры.Вставить("ДатаОкончания",НачалоДня(ТекущаяДата() -60*60*24*7));
	КонецЕсли;	
	  	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	лАктСписанияЕГАИСКПодтверждению.Загрузить(Результат.Выгрузить());
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСписокДокументовНаСервере()  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтчетОРозничныхПродажахИзменения.Ссылка.Ссылка КАК Документ,
	               |	ОтчетОРозничныхПродажахИзменения.Ссылка.СуммаДокумента КАК Сумма,
	               |	""Отчет о розн. продажах"" КАК ТипДокумента
	               |ПОМЕСТИТЬ СписокДокументов
	               |ИЗ
	               |	Документ.ОтчетОРозничныхПродажах.Изменения КАК ОтчетОРозничныхПродажахИзменения
	               |ГДЕ
	               |	ОтчетОРозничныхПродажахИзменения.Узел = &Узел
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОтчетОРозничныхПродажахИзменения.Ссылка.Ссылка,
	               |	ОтчетОРозничныхПродажахИзменения.Ссылка.СуммаДокумента
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеТоваровИзменения.Ссылка.Ссылка,
	               |	ПоступлениеТоваровИзменения.Ссылка.СуммаДокумента,
	               |	""Поступления""
	               |ИЗ
	               |	Документ.ПоступлениеТоваров.Изменения КАК ПоступлениеТоваровИзменения
	               |ГДЕ
	               |	ПоступлениеТоваровИзменения.Узел = &Узел
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступлениеТоваровИзменения.Ссылка.Ссылка,
	               |	ПоступлениеТоваровИзменения.Ссылка.СуммаДокумента
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОприходованиеТоваровИзменения.Ссылка,
	               |	ОприходованиеТоваровИзменения.Ссылка.СуммаДокумента,
	               |	""Корректировки""
	               |ИЗ
	               |	Документ.ОприходованиеТоваров.Изменения КАК ОприходованиеТоваровИзменения
	               |ГДЕ
	               |	ОприходованиеТоваровИзменения.Узел = &Узел
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СписаниеТоваровИзменения.Ссылка,
	               |	СписаниеТоваровИзменения.Ссылка.СуммаДокумента,
	               |	""Корректировки""
	               |ИЗ
	               |	Документ.СписаниеТоваров.Изменения КАК СписаниеТоваровИзменения
	               |ГДЕ
	               |	СписаниеТоваровИзменения.Узел = &Узел
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РасходныйКассовыйОрдерИзменения.Ссылка,
	               |	РасходныйКассовыйОрдерИзменения.Ссылка.СуммаДокумента,
	               |	""РКО""
	               |ИЗ
	               |	Документ.РасходныйКассовыйОрдер.Изменения КАК РасходныйКассовыйОрдерИзменения
	               |ГДЕ
	               |	РасходныйКассовыйОрдерИзменения.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОплатаПоставщику)
	               |	И РасходныйКассовыйОрдерИзменения.Узел = &Узел
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВозвратТоваровОтПокупателяИзменения.Ссылка,
	               |	ВозвратТоваровОтПокупателяИзменения.Ссылка.СуммаДокумента,
	               |	""Возвраты от покупателя""
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Изменения КАК ВозвратТоваровОтПокупателяИзменения
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателяИзменения.Узел = &Узел
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВозвратТоваровПоставщикуИзменения.Ссылка,
	               |	ВозвратТоваровПоставщикуИзменения.Ссылка.СуммаДокумента,
	               |	""Возвраты поставщику""
	               |ИЗ
	               |	Документ.ВозвратТоваровПоставщику.Изменения КАК ВозвратТоваровПоставщикуИзменения
	               |ГДЕ
	               |	ВозвратТоваровПоставщикуИзменения.Узел = &Узел
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПересортицаТоваровИзменения.Ссылка,
	               |	0,
	               |	""Корректировки""
	               |ИЗ
	               |	Документ.ПересортицаТоваров.Изменения КАК ПересортицаТоваровИзменения
	               |ГДЕ
	               |	ПересортицаТоваровИзменения.Узел = &Узел
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдерИзменения.Ссылка,
	               |	ПриходныйКассовыйОрдерИзменения.Ссылка.СуммаДокумента,
	               |	""ПКО""
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер.Изменения КАК ПриходныйКассовыйОрдерИзменения
	               |ГДЕ
	               |	ПриходныйКассовыйОрдерИзменения.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочиеДоходы)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СписокДокументов.Документ КАК Документ,
	               |	СписокДокументов.Сумма КАК Сумма,
	               |	СписокДокументов.ТипДокумента КАК ТипДокумента,
	               |	ЕСТЬNULL(РезультатыОбменаДанными.Причина, """") КАК Ошибка
	               |ИЗ
	               |	СписокДокументов КАК СписокДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыОбменаДанными КАК РезультатыОбменаДанными
	               |		ПО СписокДокументов.Документ = РезультатыОбменаДанными.ПроблемныйОбъект
	               |ИТОГИ ПО
	               |	ТипДокумента";
	
	Запрос.УстановитьПараметр("Узел", Узел);
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ЗначениеВДанныеФормы(Результат, ДокументыКВыгрузке);
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораДокумента(СсылкаНаДокумент)
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ТТНВходящаяЕГАИС") Тогда
		НоваяСтрока = ЭтотОбъект.ТТНВходящиеЕГАИСКПодтверждению.Добавить();
		НоваяСтрока.ТТНВходящаяЕГАИС = СсылкаНаДокумент;
		Попытка
			лПараметрыДокумента = РегистрыСведений.СтатусыДокументовЕГАИС.ТекущееСостояние(СсылкаНаДокумент);
			НоваяСтрока.СтатусОбработки = лПараметрыДокумента.Статус;
		Исключение
		КонецПопытки;	
		
	Иначе	
		Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, СсылкаНаДокумент);
		КонецЕсли;
		ОбновитьСписокДокументовНаСервере();
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьДатаПоследнегоОбмена()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаПоследнегоОбмена		 = Константы.ТрадДатаПоследнегоОбмена.Получить();
	ДатаПоследнегоУдачногоОбмена = Константы.ТрадДатаПоследнегоУдачногоОбмена.Получить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВводаКодаНоменклатуры(Строка, ДопПараметры) Экспорт
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодНоменклатуры = СокрЛП(Строка);
	СоответствуетШаблону = (СтрДлина(КодНоменклатуры) = 5);
	ДопустимыеСимволы = "0123456789Т";//код номенклатуры сторонних поставщиков начинается с Т
	Для Индекс = 1 По СтрДлина(КодНоменклатуры) Цикл
		Если Найти(ДопустимыеСимволы, Сред(КодНоменклатуры, Индекс, 1)) = 0 Тогда
			СоответствуетШаблону = Ложь;
		КонецЕсли;
	КонецЦикла;
		
	Если НЕ СоответствуетШаблону Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Код номенклатуры не соответствует шаблону - должен состоять из 5 цифр или буквы ""Т"" и 4 цифр");
	Иначе	
		Если ВыполнитьЗагрузкуНоменклатуры(Строка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Номенклатура " + Строка + " загружена");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка не выполнена");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьНомераНаСервере()
	Узел = ПланыОбмена.РозницаСтандартАлко.НайтиПоКоду("ЦЕНТР");
	Объект = Узел.ПолучитьОбъект();
	Объект.НомерОтправленного = 0;
	Объект.НомерПринятого = 0;
	Объект.Записать();
КонецПроцедуры

&НаСервере
Процедура ОчиститьТаблицыЗакладкиЕГАИСНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	лТТНВходящиеЕГАИСКПодтверждению = ЭтотОбъект.ТТНВходящиеЕГАИСКПодтверждению;
	лТТНВходящиеЕГАИСКПодтверждению.Очистить();
		
КонецПроцедуры	

&НаКлиенте
Процедура РазвернутьСписокДокументов()
	СтрокиДокументов = ДокументыКВыгрузке.ПолучитьЭлементы();
	Для Каждого Строка Из СтрокиДокументов Цикл
		Элементы.ДокументыКВыгрузке.Развернуть(Строка.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	Элементы.ДокументыКВыгрузкеУдалитьВсе.Видимость = РольДоступна("ПолныеПрава");
	Элементы.ДокументыКВыгрузкеУдалитьДокумент.Видимость = РольДоступна("ПолныеПрава");
	Элементы.ЗапросНоменклатуры.Видимость  = РольДоступна("ПолныеПрава");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьДокументНаСервере(Узел, СсылкаНаДокумент)
	Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, СсылкаНаДокумент);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьВсеНаСервере(Узел)
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел);
КонецПроцедуры

&НаСервере
Процедура СформироватьАктыСписанияЕГАИСРеализацияДляКафеСервер()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЭтоКафе = Ложь;
	
	Попытка 
		ЭтоКафе =  Константы.ТрадицияКонфигурацияДляКафе.Получить();
	Исключение
	КонецПопытки;	
	
	Если НЕ ЭтоКафе Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОтчетОРозничныхПродажах.Ссылка КАК ОтчетОРозничныхПродажах,
	                      |	ЧекККМТовары.Номенклатура КАК Номенклатура,
	                      |	ЧекККМАкцизныеМарки.КодАкцизнойМарки КАК КодАкцизнойМарки,
	                      |	МАКСИМУМ(ЧекККМТовары.Цена) КАК Цена,
	                      |	ВЫБОР
	                      |		КОГДА ЧекККМАкцизныеМарки.КодАкцизнойМарки ПОДОБНО &ПолеПоиска
	                      |				ИЛИ АкцизныеМаркиЕГАИС.Справка2.Поштучная = ИСТИНА
	                      |			ТОГДА ИСТИНА
	                      |		ИНАЧЕ ЛОЖЬ
	                      |	КОНЕЦ КАК ПомарочныйУчет,
	                      |	АкцизныеМаркиЕГАИС.Справка2 КАК Справка2,
	                      |	АкцизныеМаркиЕГАИС.Статус КАК СтатусАкцизнойМарки,
	                      |	ЧекККМАкцизныеМарки.АкцизнаяМарка КАК АкцизнаяМарка
	                      |ИЗ
	                      |	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.Товары КАК ЧекККМТовары
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.АкцизныеМарки КАК ЧекККМАкцизныеМарки
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцизныеМаркиЕГАИС КАК АкцизныеМаркиЕГАИС
	                      |				ПО ЧекККМАкцизныеМарки.АкцизнаяМарка = АкцизныеМаркиЕГАИС.АкцизнаяМарка
	                      |			ПО ЧекККМТовары.Ссылка = ЧекККМАкцизныеМарки.Ссылка
	                      |				И ЧекККМТовары.КлючСвязи = ЧекККМАкцизныеМарки.КлючСвязи
	                      |		ПО ОтчетОРозничныхПродажах.Ссылка = ЧекККМТовары.Ссылка.ОтчетОРозничныхПродажах
	                      |ГДЕ
	                      |	НЕ ОтчетОРозничныхПродажах.Ссылка В
	                      |				(ВЫБРАТЬ
	                      |					АктСписанияЕГАИС.ДокументОснование КАК ДокументОснование
	                      |				ИЗ
	                      |					Документ.АктСписанияЕГАИС КАК АктСписанияЕГАИС
	                      |				ГДЕ
	                      |					АктСписанияЕГАИС.Проведен
	                      |					И АктСписанияЕГАИС.ПричинаСписания = ЗНАЧЕНИЕ(Перечисление.ПричиныСписанийЕГАИС.Реализация))
	                      |	И ОтчетОРозничныхПродажах.Проведен
	                      |	И НЕ ЕСТЬNULL(ЧекККМАкцизныеМарки.КодАкцизнойМарки, 0) = 0
	                      |	И ЧекККМТовары.Номенклатура.ВидНоменклатуры.ОсобенностьУчета = ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.АлкогольнаяПродукция)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ОтчетОРозничныхПродажах.Ссылка,
	                      |	ЧекККМТовары.Номенклатура,
	                      |	ЧекККМАкцизныеМарки.КодАкцизнойМарки,
	                      |	АкцизныеМаркиЕГАИС.Справка2,
	                      |	ЧекККМАкцизныеМарки.АкцизнаяМарка,
	                      |	АкцизныеМаркиЕГАИС.Статус,
	                      |	ВЫБОР
	                      |		КОГДА ЧекККМАкцизныеМарки.КодАкцизнойМарки ПОДОБНО &ПолеПоиска
	                      |				ИЛИ АкцизныеМаркиЕГАИС.Справка2.Поштучная = ИСТИНА
	                      |			ТОГДА ИСТИНА
	                      |		ИНАЧЕ ЛОЖЬ
	                      |	КОНЕЦ
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ОтчетОРозничныхПродажах
	                      |ИТОГИ ПО
	                      |	ОтчетОРозничныхПродажах,
	                      |	ПомарочныйУчет");
	
	Запрос.Параметры.Вставить("ПолеПоиска","______________________________________________________________________________________________________________________________________________________");
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ;
	КонецЕсли;	  
	
	Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		ВыборкаПризнакПомарочныйУчет  = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПризнакПомарочныйУчет.Следующий() Цикл
			
			Списание = Документы.АктСписанияЕГАИС.СоздатьДокумент();
			Списание.Дата			   = ТекущаяДата();
			Списание.ПричинаСписания   = Перечисления.ПричиныСписанийЕГАИС.Реализация;
			Списание.Ответственный     = ПараметрыСеанса.ТекущийПользователь;
			Списание.ТорговыйОбъект    = ЗначениеНастроекПовтИсп.МагазинПоУмолчанию(Списание.ТорговыйОбъект);
			Списание.Организация       = ЗначениеНастроекПовтИсп.ОрганизацияПоУмолчанию(Списание.Организация, Списание.Ответственный);
			Списание.ОрганизацияЕГАИС  = Справочники.КлассификаторОрганизацийЕГАИС.ОрганизацияЕГАИСПоОрганизацииИТорговомуОбъекту(Списание.Организация, Списание.ТорговыйОбъект);
			Списание.ДокументОснование = Выборка.ОтчетОРозничныхПродажах;
			
			Если ВыборкаПризнакПомарочныйУчет.ПомарочныйУчет Тогда
				Списание.ВидДокумента  = Перечисления.ВидыДокументовЕГАИС.АктСписанияИзРегистра1; 
				Списание.СтатусПроверкиИПодбора = Перечисления.СтатусыПроверкиИПодбораИС.Завершено;
			Иначе	                                     
				Списание.ВидДокумента  = Перечисления.ВидыДокументовЕГАИС.АктСписанияИзРегистра2;
			КонецЕсли;	
						
			ВыборкаДетали = ВыборкаПризнакПомарочныйУчет.Выбрать();
			Пока ВыборкаДетали.Следующий() Цикл
				
				Если НЕ ЗапросПроверкиСписанияАкцизнойМаркиДляКафе(ВыборкаДетали.КодАкцизнойМарки) Тогда
					Продолжить;
				КонецЕсли;	 
				
				лИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
				
				лСправка2 = Справочники.Справки2ЕГАИС.ПустаяСсылка();
				
				Если ВыборкаПризнакПомарочныйУчет.ПомарочныйУчет Тогда
					Если ЗначениеЗаполнено(ВыборкаДетали.Справка2) Тогда
						лСправка2 = ВыборкаДетали.Справка2;
					Иначе
						лСправка2 = ВернутьСправку2(ВыборкаДетали.АкцизнаяМарка);						
					КонецЕсли;
					
					Если лСправка2 = Справочники.Справки2ЕГАИС.ПустаяСсылка() Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;	
			        				
				НоваяСтрока = Списание.Товары.Добавить();
				НоваяСтрока.ИдентификаторСтроки  = лИдентификаторСтроки;
				НоваяСтрока.Номенклатура 		 = ВыборкаДетали.Номенклатура;
				НоваяСтрока.АлкогольнаяПродукция = Справочники.КлассификаторАлкогольнойПродукцииЕГАИС.НайтиПоКоду(ВыборкаДетали.Номенклатура.КодЕгаис);
				НоваяСтрока.Количество 		     = 1;
				НоваяСтрока.КоличествоУпаковок   = 1;
				НоваяСтрока.Сумма                = ВыборкаДетали.Цена; 
				НоваяСтрока.Цена                 = ВыборкаДетали.Цена;

				
				Если ВыборкаПризнакПомарочныйУчет.ПомарочныйУчет Тогда
					 НоваяСтрока.Справка2 = лСправка2;
				КонецЕсли;	
				 
				ОбработатьРегистрСведенийАкцизныеМарки(ВыборкаДетали.АкцизнаяМарка,Списание.ОрганизацияЕГАИС);
 
					
				НоваяСтрока = Списание.АкцизныеМарки.Добавить();
				НоваяСтрока.ИдентификаторСтроки = лИдентификаторСтроки;
				НоваяСтрока.КодАкцизнойМарки 	= ВыборкаДетали.КодАкцизнойМарки;
				//НоваяСтрока.АкцизнаяМарка		= Справочники.ШтрихкодыУпаковокТоваров. .ПолучитьАкцизнуюМаркуПоКоду(ВыборкаДетали.КодАкцизнойМарки);
				НоваяСтрока.АкцизнаяМарка		= Справочники.ШтрихкодыУпаковокТоваров.ПолучитьПоЗначениюШтрихкода(ВыборкаДетали.КодАкцизнойМарки);

				НоваяСтрока.Количество			= 1;
				
			КонецЦикла;
			
			Если НЕ Списание.Товары.Количество()  = 0 Тогда
				Списание.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
				НоваяСтрока = ЭтотОбъект.АктСписанияЕГАИСКПодтверждению.Добавить();
				НоваяСтрока.АктСписанияЕГАИС =   Списание.Ссылка;
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ОбработатьРегистрСведенийАкцизныеМарки(пАкцизнаяМарка,пОрганизацияЕГАИС)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.АкцизныеМаркиЕГАИС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.АкцизнаяМарка.Установить(пАкцизнаяМарка);
	НаборЗаписей.Записать();   
		
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////////////////////////////////
//СЕРВИСНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ  ЕГАИС

&НаСервере
Функция ЗаполнитьРасхожденияВДокументеТТНВходящая(пТТНВходящаяЕГАИС)
	
	ТаблицаРасхождений =  ТаблицаРасхожденийТТН_ЕГАИС(пТТНВходящаяЕГАИС);
	 		
	Попытка
		
		ДокументОбъект = пТТНВходящаяЕГАИС.ПолучитьОбъект();
		
		Для каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
			
			ЭтоТоварБезАкцизныхМарок = ?(пТТНВходящаяЕГАИС.АкцизныеМарки.Найти(СтрокаТовары.Справка2,"Справка2")= Неопределено,Истина,Ложь);
						
			Если ТаблицаРасхождений <> Неопределено Тогда
				НайденнаяСтрока = ТаблицаРасхождений.Найти(СтрокаТовары.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если ЗначениеЗаполнено(НайденнаяСтрока) И ЭтоТоварБезАкцизныхМарок Тогда
					СтрокаТовары.КоличествоФакт = НайденнаяСтрока.КоличествоФакт;
				Иначе
					СтрокаТовары.КоличествоФакт = СтрокаТовары.Количество;
				КонецЕсли;
			Иначе
				СтрокаТовары.КоличествоФакт = 0;
			КонецЕсли;
			
		КонецЦикла;
		
		ДокументОбъект.СтатусПроверкиИПодбора = Перечисления.СтатусыПроверкиИПодбораИС.Завершено;
		ДокументОбъект.ЕстьРасхождения = Истина;
		ДокументОбъект.Записать();
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции	

